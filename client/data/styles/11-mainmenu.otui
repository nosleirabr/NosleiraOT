MainMenuPanel < UIWidget
  focusable: false
  image-source: /images/ui/menubarleft

// UIButton sem o estilo Button (padding 5/10 + clip 22x23 do button.png).
TibiaButton < UIButton
  font: cipsoftFont
  color: #eeeeee
  text-offset: 0 0
  text-align: center
  padding: 0
  focusable: true
  image-source: /images/ui/option_button
  image-smooth: false
  image-color: #ffffffff
  change-cursor-image: true
  cursor: pointer

  $pressed:
    text-offset: 1 1

  $disabled:
    color: #eeeeee88
    opacity: 0.8
    change-cursor-image: false

MainMenuButton < TibiaButton
  size: 86 20

EnterGameButton < TibiaButton
  size: 43 20
  image-border: 1
