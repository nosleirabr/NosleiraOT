EnterGameWindow
  id: enterGame
  @onEnter: EnterGame.doLogin()
  size: 236 150
  MenuLabel
    id: accountLabel
    !text: tr('Account number:')
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 15
    margin-top: 15
    text-auto-resize: true

  TextEdit
    id: accountNameTextEdit
    anchors.left: accountLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: accountLabel.verticalCenter
    margin-left: 10
    margin-right: 15
    margin-top: 0

  MenuLabel
    id: passwordLabel
    !text: tr('Password:')
    anchors.left: parent.left
    anchors.top: accountLabel.bottom
    margin-left: 15
    margin-top: 15
    text-auto-resize: true

  PasswordTextEdit
    id: accountPasswordTextEdit
    anchors.left: accountNameTextEdit.left
    anchors.right: parent.right
    anchors.verticalCenter: passwordLabel.verticalCenter
    margin-right: 15
    margin-top: 0

  MenuLabel
    id: noAccountLabel
    !text: tr('If you don\'t have\nan account yet:')
    anchors.left: parent.left
    anchors.top: passwordLabel.bottom
    margin-left: 15
    margin-top: 15
    text-auto-resize: true

  Button
    id: buttonCreateAccount
    !text: tr('Create Account')
    anchors.left: accountNameTextEdit.left
    anchors.right: parent.right
    anchors.verticalCenter: noAccountLabel.verticalCenter
    margin-right: 15
    margin-top: 0
    @onClick: g_platform.openUrl("http://www.tibia.com")

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonOk.top
    margin-left: 15
    margin-right: 15
    margin-bottom: 10

  Button
    id: buttonCancel
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 15
    margin-bottom: 15
    !text: tr('Cancel')
    width: 60
    @onClick: EnterGame.cancel()

  Button
    id: buttonOk
    anchors.right: buttonCancel.left
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 15
    !text: tr('Ok')
    width: 60
    @onClick: EnterGame.doLogin()

  Panel
    id: serverSelectorPanel
    height: 0
    visible: false
    ComboBox
      id: serverSelector

  Panel
    id: customServerSelectorPanel
    height: 0
    visible: false
    TextEdit
      id: serverHostTextEdit
    ComboBox
      id: clientVersionSelector





