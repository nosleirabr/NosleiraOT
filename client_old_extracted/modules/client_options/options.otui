OptionCheckBox < CheckBox
  @onCheckChange: modules.client_options.setOption(self:getId(), self:isChecked())
  height: 16

  $!first:
    margin-top: 2

OptionScrollbar < HorizontalScrollBar
  step: 1
  @onValueChange: modules.client_options.setOption(self:getId(), self:getValue())
  
OptionPanel < Panel
  layout:
    type: verticalBox

MainWindow
  id: optionsWindow
  !text: tr('Options')
  size: 320 320

  @onEnter: modules.client_options.hide()
  @onEscape: modules.client_options.hide()

  Button
    id: generalButton
    !text: tr('General')
    width: 80
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 15
    margin-left: 10
    @onClick: modules.client_options.showGeneral()
    
  Label
    !text: tr('Change general\ngame options')
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 15
    text-auto-resize: true

  Button
    id: graphicsButton
    !text: tr('Graphics')
    width: 80
    anchors.left: parent.left
    anchors.top: generalButton.bottom
    margin-top: 15
    margin-left: 10
    @onClick: modules.client_options.showGraphics()
    
  Label
    !text: tr('Change graphics and\nperformance settings')
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 15
    text-auto-resize: true

  Button
    id: consoleButton
    !text: tr('Console')
    width: 80
    anchors.left: parent.left
    anchors.top: graphicsButton.bottom
    margin-top: 15
    margin-left: 10
    @onClick: modules.client_options.showConsole()
    
  Label
    !text: tr('Customise the console')
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 15
    margin-top: 4
    text-auto-resize: true

  Button
    id: hotkeysButton
    !text: tr('Hotkeys')
    width: 80
    anchors.left: parent.left
    anchors.top: consoleButton.bottom
    margin-top: 15
    margin-left: 10
    @onClick: modules.game_hotkeys.show()
    
  Label
    !text: tr('Edit your hotkey texts')
    anchors.left: prev.right
    anchors.top: prev.top
    margin-left: 15
    margin-top: 4
    text-auto-resize: true

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: hotkeysButton.bottom
    margin-top: 15

  Button
    id: okButton
    !text: tr('Ok')
    width: 60
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: modules.client_options.hide()
