<br/>
<form action="{{ getLink('characters') }}" method="post" style="margin: 0; padding: 0;">
	{{ csrf() }}
	{% set title = 'Search Character' %}
	{% set content %}
	<table style="width: 100%; border-collapse: collapse;">
		<tbody>
		<tr>
			<td>
				<div class="TableShadowContainerRightTop">
					<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/content/table-shadow-rt.gif);"></div>
				</div>
				<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-rm.gif);">
					<div class="TableContentContainer">
						<table class="TableContent" width="100%">
							<tbody>
								<tr bgcolor="{{ getStyle(1) }}">
									<td style="padding: 10px 14px; border: 1px solid #FAF0D7; vertical-align: middle;">
										<table border="0" cellspacing="0" cellpadding="0" style="width: auto;">
											<tr>
												<td style="vertical-align: middle; font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 11px; font-weight: bold; color: #5A2800; padding-right: 10px;">
													Name:
												</td>
												<td style="vertical-align: middle; padding-right: 10px;">
													<input style="width: 280px; height: 18px; padding: 2px 6px; font-size: 11px; border: 1px solid #7F9DB9;" name="name" value="" maxlength="29" placeholder="Enter character name..." {% if autofocus %}autofocus{% endif %}/>
												</td>
												<td style="vertical-align: middle;">
													<input type="submit" value="Submit" style="background: #4B4B4B; color: #FFFFFF; font-weight: bold; font-size: 11px; border: 1px solid #222222; border-radius: 10px; padding: 2px 20px; cursor: pointer; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);"/>
												</td>
											</tr>
										</table>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="TableShadowContainer">
					<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bm.gif);">
						<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bl.gif);"></div>
						<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-br.gif);"></div>
					</div>
				</div>
			</td>
		</tr>
		</tbody>
	</table>
	{% endset %}
	{% include 'tables.headline.html.twig' with {'title': title, 'content': content} %}
</form>
