{% set title = 'Support in game' %}
{% set content %}
{% set i = 0 %}

{% for group in groupmember|reverse %}
	{% if group.members is not empty %}
	<div style="text-align:center; margin-top: 15px; margin-bottom: 5px;">
		<h2 style="color: #7E3B00; font-weight: bold; margin: 0; padding: 0;">{{ group.group_name|capitalize }}</h2>
	</div>

	<table cellspacing="1" cellpadding="4" border="0" width="100%" style="box-shadow: 2px 5px 10px rgba(0,0,0,0.4); margin-bottom: 20px;">
		<tr bgcolor="{{ config.vdarkborder }}">
			<td width="20%" class="white">
				<b>Group</b>
			</td>

			<td width="35%" class="white">
				<b>Name</b>
			</td>

			<td width="15%" class="white">
				<b>World</b>
			</td>

			<td width="20%" class="white">
				<b>Ultimo Acesso</b>
			</td>

			<td width="10%" class="white">
				<b>Status</b>
			</td>
		</tr>

		{% for member in group.members %}
		{% set i = i + 1 %}
			<tr bgcolor="{{ getStyle(i) }}" style="height: 32px;">
			
			<td>
				<div style="position: relative; width: 22px; height: 22px; overflow: hidden; float: left; border: 1px solid #111; box-shadow: 1px 1px 2px rgba(0,0,0,0.5); background: #3b3b3b; margin-top: 5px;">
					<img style="position: absolute; margin-top: -30px; margin-left: -32px;" src="{{ member.outfit }}&anim=0" alt="player outfit"/>
				</div>
				<div style="float: left; margin-left: 8px; line-height: 32px; white-space: nowrap;">
				{% if group.group_name|lower == 'administrador' %}
					<span style="color: red; font-weight: bold;">Administrador</span>
				{% elseif group.group_name|lower == 'community manager' %}
					<span style="color: #3333FF; font-weight: bold;">Community Manager</span>
				{% elseif group.group_name|lower == 'gamemaster' %}
					<span style="color: green; font-weight: bold;">Gamemaster</span>
				{% elseif group.group_name|lower == 'senior tutor' %}
					<span style="color: #CD853F; font-weight: bold;">Senior Tutor</span>
				{% elseif group.group_name|lower == 'tutor' %}
					<span style="color: #CD853F; font-weight: bold;">Tutor</span>
				{% else %}
					<span style="font-weight: bold;">{{ group.group_name|capitalize }}</span>
				{% endif %}
				</div>
			</td>

			<td>
				{% if setting('core.account_country') %}
					{{ member.flag_image|raw }}
				{% endif %}
				<span style="font-weight: bold; color: #0044BB;">{{ member.link|raw }}</span>
			</td>

			<td>
				<span style="color: #444;">{{ member.world_name }}</span>
			</td>

			<td>
				<span style="border-bottom: 1px dotted #555;" title="{{ member.last_login }}">{{ member.last_login }}</span>
			</td>

			<td>
				{% if member.status %}
					<span style="color: green; font-weight: bold;">Online</span>
				{% else %}
					<span style="color: red;">Offline</span>
				{% endif %}
			</td>
		</tr>
		{% endfor %}
	</table>
	{% endif %}
{% endfor %}

{% endset %}
{% include 'tables.headline.html.twig' %}
