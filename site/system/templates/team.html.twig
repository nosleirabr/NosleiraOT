{% set title = 'Support in game' %}
{% set content %}

<div style="background-color: #f1e2c3; border: 1px solid #7E3B00; border-radius: 4px; padding: 15px; margin-bottom: 15px; text-align: center; box-shadow: 2px 2px 5px rgba(0,0,0,0.3);">
	<h2 style="color: #A65200; font-size: 16px; margin: 0 0 10px 0; font-family: Tahoma, sans-serif;">
		<img src="{{ template_path }}/images/content/headline-bracer-left.gif" style="vertical-align: middle;"> CENTRAL DE SUPORTE & ADMINISTRAÇÃO <img src="{{ template_path }}/images/content/headline-bracer-right.gif" style="vertical-align: middle;">
	</h2>
	<p style="margin: 0; font-size: 11px; color: #333; line-height: 1.4; font-family: Tahoma, sans-serif;">
		Bem-vindo à página oficial de suporte do <b>NosleiraOT</b>!<br>
		Nossa equipe de <b>Administração, Community Managers, Gamemasters e Tutores</b> trabalha dedicada e continuamente para garantir uma experiência de jogo equilibrada, segura, transparente e divertida para toda a nossa comunidade.<br><br>
		<i style="color: #555;">💡 Precisa de assistência in-game? Envie um Report/Help no canal oficial ou contate um membro da equipe com status <b>Online</b>.</i>
	</p>
</div>

{% for group in groupmember|reverse %}
	{% if group.members is not empty %}
	
	<div style="background: linear-gradient(to bottom, #3E240D, #2B1605); border: 1px solid #111; padding: 4px; text-align: center; margin-top: 15px; margin-bottom: 5px; box-shadow: 1px 1px 3px rgba(0,0,0,0.5); border-radius: 6px;">
		<h2 style="color: #FFD700; font-weight: bold; font-size: 13px; margin: 0; padding: 0; font-family: Tahoma, sans-serif; text-shadow: 1px 1px 1px #000;">✦ {{ group.group_name|upper }} ✦</h2>
	</div>

	<table cellspacing="0" cellpadding="4" border="0" width="100%" style="border-collapse: separate; border-spacing: 0; border: 1px solid #7E3B00; border-radius: 6px; overflow: hidden; box-shadow: 2px 2px 5px rgba(0,0,0,0.3); margin-bottom: 20px; background-color: #F1E0C6;">
		<tr style="background-color: #4A4A4A; color: #FFFFFF; font-size: 11px; font-weight: bold; border-bottom: 2px solid #111;">
			<td width="30%" style="padding: 6px 10px; border-bottom: 2px solid #222;">Group</td>
			<td width="30%" style="padding: 6px 10px; border-bottom: 2px solid #222;">Name</td>
			<td width="15%" style="padding: 6px 10px; border-bottom: 2px solid #222;">World</td>
			<td width="15%" style="padding: 6px 10px; border-bottom: 2px solid #222;">Ultimo Acesso</td>
			<td width="10%" style="padding: 6px 10px; border-bottom: 2px solid #222;">Status</td>
		</tr>

		{% for member in group.members %}
		{% set i = i + 1 %}
		<tr bgcolor="{{ getStyle(i) }}" style="height: 36px;">
			<td style="padding-left: 10px; vertical-align: middle;">
				<div style="display: flex; align-items: center;">
					<div style="position: relative; width: 24px; height: 24px; overflow: hidden; border: 2px solid #FFCC00; border-radius: 4px; box-shadow: 1px 1px 2px rgba(0,0,0,0.5); background: #3b3b3b; margin-right: 8px; flex-shrink: 0;">
						<img style="position: absolute; top: -30px; left: -32px;" src="{{ member.outfit }}&anim=0" alt="player outfit"/>
					</div>
					<div>
						<style>
							@keyframes piscar-grupo { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
							.grp-blink { color: lime; font-weight: bold; text-shadow: 0 0 6px lime; }
						</style>
						{% if group.group_id == 6 %}
							<span class="grp-blink">Administrador</span>
						{% elseif group.group_id == 5 %}
							<span style="color: #CC0000; font-weight: bold;">Community M...</span>
						{% elseif group.group_id == 4 %}
							<span style="color: #0044BB; font-weight: bold;">Gamemaster</span>
						{% elseif group.group_id == 3 %}
							<span style="color: #CD853F; font-weight: bold;">Senior Tutor</span>
						{% elseif group.group_id == 2 %}
							<span style="color: #9933CC; font-weight: bold;">Tutor</span>
						{% else %}
							<span style="font-weight: bold;">{{ group.group_name|capitalize }}</span>
						{% endif %}
					</div>
				</div>
			</td>

			<td style="vertical-align: middle;">
				<div style="display: flex; align-items: center;">
					{% if setting('core.account_country') %}
						<span style="margin-right: 4px;">{{ member.flag_image|raw }}</span>
					{% endif %}
					<a href="{{ member.link }}" style="font-weight: bold; color: #0044BB; font-size: 11px; text-decoration: none;">
						{% if group.group_id == 6 %}
							[GOD] {{ member.name }}
						{% elseif group.group_id == 5 %}
							[CM] {{ member.name }}
						{% elseif group.group_id == 4 %}
							[GM] {{ member.name }}
						{% else %}
							{{ member.name }}
						{% endif %}
					</a>
				</div>
			</td>

			<td style="vertical-align: middle; color: #111; font-weight: bold; font-size: 11px;">
				{{ member.world_name|default('NosleiraOT') }}
			</td>

			<td style="vertical-align: middle;">
				<span style="border-bottom: 1px dotted #555; color: #555; font-size: 10px;" title="{{ member.last_login }}">
					{% if member.last_login == 'Never.' or member.last_login == 'Never logged in.' %}
						Never.
					{% else %}
						{{ member.last_login }}
					{% endif %}
				</span>
			</td>

			<td style="vertical-align: middle;">
				<style>
					@keyframes piscar { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
					.st-online { color: lime; font-weight: bold; text-shadow: 0 0 6px lime; animation: piscar 1.2s infinite; }
					.st-offline { color: #FF0000; font-weight: bold; animation: piscar 1.2s infinite; }
				</style>
				{% if member.status %}
					<span class="st-online">Online</span>
				{% else %}
					<span class="st-offline">Offline</span>
				{% endif %}
			</td>
		</tr>
		{% endfor %}
	</table>
	{% endif %}
{% endfor %}

{% endset %}
{% include 'tables.headline.html.twig' with {'title': title, 'content': content} %}
