{% set title = 'Support in game' %}
{% set content %}

{# Compensa o margin-left:3px do .InnerTableContainer (Table3 do tibiacom): sem isso o conteudo vaza na borda direita. O margin-right:6px deixa 3px de respiro igual ao lado esquerdo. #}
<div style="margin-right: 6px;">
<style>
.TableContent th {
    background-color: #505050;
    color: #fff;
    padding: 5px;
    text-align: left;
    font-weight: bold;
    border: 1px solid #faf0d7;
}
.TableContent td {
    border: 1px solid #faf0d7;
    padding: 4px;
}
.row-odd td { background-color: #D4C0A1; }
.row-even td { background-color: #F1E0C6; }
</style>

{% set banner_content %}
	<tr>
		<td style="padding: 15px; text-align: center; background-color: #f1e2c3;">
			<h2 style="color: #A65200; font-size: 16px; margin: 0 0 10px 0; font-family: Tahoma, sans-serif;">
				<img src="{{ template_path }}/images/content/headline-bracer-left.gif" style="vertical-align: middle;"> CENTRAL DE SUPORTE & ADMINISTRA&Ccedil;&Atilde;O <img src="{{ template_path }}/images/content/headline-bracer-right.gif" style="vertical-align: middle;">
			</h2>
			<style>
				@keyframes piscar { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
				.st-online-banner { color: #00B400; font-weight: bold; animation: piscar 1.2s infinite; }
			</style>
			<p style="margin: 0; font-size: 11px; color: #333; line-height: 1.4; font-family: Tahoma, sans-serif;">
				Bem-vindo &agrave; p&aacute;gina oficial de suporte do <b>NosleiraOT</b>!<br>
				Nossa equipe de <b>Administra&ccedil;&atilde;o, Community Managers, Gamemasters e Tutores</b> trabalha dedicada e continuamente para garantir uma experi&ecirc;ncia de jogo equilibrada, segura, transparente e divertida para toda a nossa comunidade.<br><br>
				<i style="color: #555;">&#128161; Precisa de assist&ecirc;ncia in-game? Envie um Report/Help no canal oficial ou contate um membro da equipe com status <span class="st-online-banner">Online</span>.</i>
			</p>
		</td>
	</tr>
{% endset %}
{% include 'tables.shadowbox.html.twig' with {'content': banner_content} %}
<br>

{% for group in groupmember|reverse %}
	{% if group.members is not empty %}
	
{% set group_content %}
		<tr>
        <th width="30%">Group</th>
        <th width="30%">Name</th>
        <th width="15%">World</th>
        <th width="15%">Ultimo Acesso</th>
        <th width="10%">Status</th>
    </tr>

		{% for member in group.members %}
		{% set i = i + 1 %}
		<tr bgcolor="{{ getStyle(i) }}" style="height: 36px;">
			<td style="padding-left: 10px; vertical-align: middle;">
				<div style="display: flex; align-items: center;">
																									<div style="position: relative; width: 20px; height: 20px; margin-right: 8px; flex-shrink: 0; display: flex; justify-content: center; align-items: center; box-shadow: 1px 1px 2px rgba(0,0,0,0.5);">
						{% set staff_icon = 'tutor' %}
						{% if group.group_id == 6 %} {% set staff_icon = 'admin' %}
						{% elseif group.group_id == 5 %} {% set staff_icon = 'cm' %}
						{% elseif group.group_id == 4 %} {% set staff_icon = 'gm' %}
						{% elseif group.group_id == 3 %} {% set staff_icon = 'senior' %}
						{% endif %}
						<img src="images/staff/{{ staff_icon }}.gif" alt="staff icon" style="max-width: 100%; max-height: 100%; object-fit: none;" />
					</div>
					<div>
																		
						{% if group.group_id == 6 %}
							<span style="color: #00A800; font-weight: bold;">Administrador</span>
						{% elseif group.group_id == 5 %}
							<span style="color: #CC0000; font-weight: bold;">Community M...</span>
						{% elseif group.group_id == 4 %}
							<span style="color: #0044BB; font-weight: bold;">Gamemaster</span>
						{% elseif group.group_id == 3 %}
							<span style="color: #DA70D6; font-weight: bold;">Senior Tutor</span>
						{% elseif group.group_id == 2 %}
							<span style="color: #9933CC; font-weight: bold;">Tutor</span>
						{% else %}
							<span style="font-weight: bold;">{{ group.group_name|capitalize }}</span>
						{% endif %}
					</div>
				</div>
			</td>

			<td style="vertical-align: middle;">
				<div style="display: flex; align-items: center;">
					{% if setting('core.account_country') %}
						<span style="margin-right: 4px;">{{ member.flag_image|raw }}</span>
					{% endif %}
					<a href="{{ member.link }}" style="font-weight: bold; color: #0044BB; font-size: 11px; text-decoration: none;">
						{% if group.group_id == 6 %}
							[GOD] {{ member.name }}
						{% elseif group.group_id == 5 %}
							[CM] {{ member.name }}
						{% elseif group.group_id == 4 %}
							[GM] {{ member.name }}
						{% else %}
							{{ member.name }}
						{% endif %}
					</a>
				</div>
			</td>

			<td style="vertical-align: middle; color: #111; font-weight: bold; font-size: 11px;">
				{{ member.world_name|default('NosleiraOT') }}
			</td>

			<td style="vertical-align: middle;">
				<span style="color: #004294; border-bottom: 1px dotted #888; cursor: help;" title="{{ member.last_login }}">
					{% if member.last_login == 'Never.' or member.last_login == 'Never logged in.' %}
						Never.
					{% else %}
						{{ member.last_login }}
					{% endif %}
				</span>
			</td>

			<td style="vertical-align: middle;">
				<style>
					@keyframes piscar { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
					.st-online { color: lime; font-weight: bold; text-shadow: 0 0 6px lime; animation: piscar 1.2s infinite; }
					.st-offline { color: #FF0000; font-weight: bold; animation: piscar 1.2s infinite; }
				</style>
				{% if member.status %}
					<span class="st-online">Online</span>
				{% else %}
					<span class="st-offline">Offline</span>
				{% endif %}
			</td>
		</tr>
		{% endfor %}
	{% endset %}
	{% set group_shadowbox %}
		{% include 'tables.shadowbox.html.twig' with {'content': group_content} %}
	{% endset %}
	{% include 'tables.headline.html.twig' with {'title': group.group_name|capitalize, 'content': group_shadowbox} %}
	<br>
	{% endif %}
{% endfor %}

</div>

{% endset %}
{% include 'tables.headline.html.twig' with {'title': title, 'content': content} %}






















