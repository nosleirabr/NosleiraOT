<style>
/* === ESTILOS DA TABELA DE SPELLS (ESTILO MODERNO TIBIA 7.4) === */
.spells-container {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #212529;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
}

/* Barra de Abas Superiores */
.spells-nav-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
    border-bottom: 2px solid #b0c4de;
    padding-bottom: 6px;
}

.spells-tab-btn {
    background: #e4edf5;
    border: 1px solid #9bb7d4;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 700;
    color: #1a4268;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
}

.spells-tab-btn:hover {
    background: #d4e4f3;
    color: #0b2e4f;
}

.spells-tab-btn.active {
    background: #1b4975;
    color: #ffffff;
    border-color: #1b4975;
    box-shadow: 0 -2px 5px rgba(0,0,0,0.1);
}

.spells-tab-btn .badge-count {
    background: rgba(0, 0, 0, 0.15);
    color: inherit;
    font-size: 11px;
    padding: 1px 6px;
    border-radius: 10px;
}

.spells-tab-btn.active .badge-count {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
}

/* Barra de Filtros e Busca */
.spells-filter-bar {
    background: #f0f4f8;
    border: 1px solid #cfdce8;
    border-radius: 6px;
    padding: 10px 14px;
    margin-bottom: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.spells-filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
}

.spells-filter-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: #334e68;
}

.spells-filter-item select,
.spells-search-input {
    background: #ffffff;
    border: 1px solid #bcccdc;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 12px;
    color: #102a43;
    outline: none;
    transition: border-color 0.2s;
}

.spells-filter-item select:focus,
.spells-search-input:focus {
    border-color: #1b4975;
}

.spells-search-input {
    width: 200px;
    padding-left: 26px;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%23627d98" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>');
    background-repeat: no-repeat;
    background-position: 7px center;
}

/* Tabela Estilo Reference Screenshot */
.spells-table-wrapper {
    overflow-x: auto;
    background: #ffffff;
    border: 1px solid #c9d8e5;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}

table.spells-table {
    width: 100% !important;
    border-collapse: collapse !important;
    font-size: 12px;
}

table.spells-table thead th {
    background-color: #d1dfed !important;
    color: #102a43 !important;
    font-weight: 700 !important;
    padding: 10px 8px !important;
    border-bottom: 2px solid #9fb3c8 !important;
    border-right: 1px solid #bed0e0 !important;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
}

table.spells-table thead th:last-child {
    border-right: none !important;
}

table.spells-table tbody tr {
    transition: background-color 0.15s ease;
}

table.spells-table tbody tr.odd {
    background-color: #f7fafc;
}

table.spells-table tbody tr.even {
    background-color: #ffffff;
}

table.spells-table tbody tr:hover {
    background-color: #e8f2fc !important;
}

table.spells-table tbody td {
    padding: 8px 8px !important;
    border-bottom: 1px solid #e2e8f0 !important;
    border-right: 1px solid #edf2f7 !important;
    vertical-align: middle !important;
}

table.spells-table tbody td:last-child {
    border-right: none !important;
}

/* Coluna Nome */
.spell-name-text {
    font-weight: 700;
    font-size: 12.5px;
    color: #102a43;
    white-space: nowrap;
}

.spell-short-badge {
    background: #e2e8f0;
    color: #475569;
    font-size: 10px;
    padding: 2px 4px;
    border-radius: 3px;
    margin-left: 4px;
    font-weight: 600;
}

/* Coluna Ícone */
.spell-icon-box {
    width: 36px;
    height: 36px;
    background-color: #1e2227;
    border: 1px solid #4a5568;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 4px rgba(0,0,0,0.6);
    margin: 0 auto;
}

.spell-icon-img {
    width: 32px;
    height: 32px;
    image-rendering: pixelated;
    display: block;
}

/* Coluna ML / Level */
.spell-ml-box {
    text-align: center;
    font-weight: 700;
    white-space: nowrap;
}

.spell-ml-value {
    color: #1b4975;
    font-size: 12px;
}

.spell-ml-sub {
    font-size: 10.5px;
    color: #627d98;
    display: block;
    font-weight: normal;
}

/* Coluna Vocação */
.voc-badge {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 10.5px;
    font-weight: 600;
    margin: 1px;
    white-space: nowrap;
}

.voc-sorcerer { background: #ede9fe; color: #5b21b6; border: 1px solid #ddd6fe; }
.voc-druid { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
.voc-paladin { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
.voc-knight { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
.voc-all { background: #e2e8f0; color: #334155; border: 1px solid #cbd5e1; }
.voc-default { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }

/* Coluna Premium (Prem) */
.prem-icon-yes {
    color: #16a34a;
    font-size: 16px;
    font-weight: 900;
    text-align: center;
    display: block;
}

.prem-icon-no {
    color: #dc2626;
    font-size: 16px;
    font-weight: 900;
    text-align: center;
    display: block;
}

/* Coluna Spell Words */
.spell-formula-pill {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 3px 6px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 11.5px;
    font-weight: 600;
    color: #1e293b;
    white-space: nowrap;
    display: inline-block;
}

/* Coluna Mana */
.spell-mana-val {
    font-weight: 700;
    color: #0369a1;
    text-align: center;
    display: block;
}

/* Coluna Grupo */
.group-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
}

.group-ataque { background: #ffe4e6; color: #9f1239; border: 1px solid #fecdd3; }
.group-cura { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
.group-suporte { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }
.group-campo { background: #ffedd5; color: #9a3412; border: 1px solid #fed7aa; }
.group-conjuracao { background: #f3e8ff; color: #6b21a8; border: 1px solid #e9d5ff; }

/* Coluna Efeito */
.spell-effect-text {
    font-size: 11.5px;
    line-height: 1.45;
    color: #334155;
}

/* Ajustes DataTables */
.dataTables_wrapper .dataTables_paginate .paginate_button.current,
.dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
    background: #1b4975 !important;
    color: #ffffff !important;
    border-color: #1b4975 !important;
    border-radius: 4px;
}

.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter {
    display: none !important; /* Usamos nossa própria barra de busca e filtros mais ricos */
}
</style>

<div class="spells-container">

    <!-- Abas de Categoria (Tabs) -->
    <div class="spells-nav-tabs">
        <a href="javascript:void(0);" class="spells-tab-btn active" data-tab="all">
            ✨ Todas as Magias <span class="badge-count">{{ counts.all }}</span>
        </a>
        <a href="javascript:void(0);" class="spells-tab-btn" data-tab="instant">
            ⚡ Instantâneas <span class="badge-count">{{ counts.instant }}</span>
        </a>
        <a href="javascript:void(0);" class="spells-tab-btn" data-tab="rune">
            📜 Runas <span class="badge-count">{{ counts.rune }}</span>
        </a>
        <a href="javascript:void(0);" class="spells-tab-btn" data-tab="conjure">
            🏹 Conjurações <span class="badge-count">{{ counts.conjure }}</span>
        </a>
    </div>

    <!-- Barra de Filtros e Busca Rápida -->
    <div class="spells-filter-bar">
        <div class="spells-filter-group">
            <div class="spells-filter-item">
                <span>Vocação:</span>
                <select id="filter_vocation">
                    <option value="all" {% if selected_vocation == 'all' %}selected{% endif %}>Todas as Vocações</option>
                    <option value="sorcerer" {% if selected_vocation == 'sorcerer' %}selected{% endif %}>Sorcerer</option>
                    <option value="druid" {% if selected_vocation == 'druid' %}selected{% endif %}>Druid</option>
                    <option value="paladin" {% if selected_vocation == 'paladin' %}selected{% endif %}>Paladin</option>
                    <option value="knight" {% if selected_vocation == 'knight' %}selected{% endif %}>Knight</option>
                </select>
            </div>

            <div class="spells-filter-item">
                <span>Grupo:</span>
                <select id="filter_group">
                    <option value="all">Todos os Grupos</option>
                    <option value="Ataque">Ataque</option>
                    <option value="Cura">Cura</option>
                    <option value="Suporte">Suporte</option>
                    <option value="Runa de Ataque">Runa de Ataque</option>
                    <option value="Runa de Cura">Runa de Cura</option>
                    <option value="Runa de Campo">Runa de Campo</option>
                    <option value="Runa de Suporte">Runa de Suporte</option>
                    <option value="Conjuração">Conjuração</option>
                </select>
            </div>

            <div class="spells-filter-item">
                <span>Conta:</span>
                <select id="filter_prem">
                    <option value="all">Todas as Contas</option>
                    <option value="free">Free Account</option>
                    <option value="prem">Premium Account</option>
                </select>
            </div>
        </div>

        <div>
            <input type="text" id="spells_search" class="spells-search-input" placeholder="Buscar magia, fórmula, efeito...">
        </div>
    </div>

    <!-- Tabela Principal de Spells -->
    <div class="spells-table-wrapper">
        <table id="spellsTable" class="spells-table">
            <thead>
                <tr>
                    <th style="width: 140px;">Nome</th>
                    <th style="width: 44px; text-align: center;">Ícone</th>
                    <th style="width: 90px; text-align: center;">ML / Level</th>
                    <th style="width: 110px;">Voc</th>
                    <th style="width: 45px; text-align: center;">Prem</th>
                    <th style="width: 130px;">Spell Words</th>
                    <th style="width: 55px; text-align: center;">Mana</th>
                    <th style="width: 105px;">Grupo</th>
                    <th>Efeito</th>
                </tr>
            </thead>
            <tbody>
                {% for spell in spells %}
                <tr data-type="{{ spell.type_tab }}"
                    data-voc="{{ spell.voc_filter }}"
                    data-group="{{ spell.group }}"
                    data-prem="{{ spell.premium ? 'prem' : 'free' }}">
                    
                    <!-- Nome -->
                    <td>
                        <span class="spell-name-text">{{ spell.name }}</span>
                        {% if spell.short_name %}
                            <span class="spell-short-badge">{{ spell.short_name }}</span>
                        {% endif %}
                    </td>

                    <!-- Ícone -->
                    <td style="text-align: center;">
                        <div class="spell-icon-box" title="{{ spell.name }}">
                            <img src="{{ spell.icon }}" class="spell-icon-img" alt="{{ spell.name }}" loading="lazy" />
                        </div>
                    </td>

                    <!-- ML / Level -->
                    <td data-order="{{ spell.maglevel_sort }}">
                        <div class="spell-ml-box">
                            {{ spell.maglevel_display|raw }}
                        </div>
                    </td>

                    <!-- Vocações -->
                    <td>
                        {{ spell.vocations_html|raw }}
                        {% if spell.type == 'rune' and spell.use_vocations %}
                            <div style="font-size: 9.5px; color: #64748b; margin-top: 2px;">
                                Uso: {{ spell.use_vocations|join(', ') }}
                            </div>
                        {% endif %}
                    </td>

                    <!-- Premium -->
                    <td style="text-align: center;" data-order="{{ spell.premium }}">
                        {% if spell.premium == 1 %}
                            <span class="prem-icon-yes" title="Premium Account">✔</span>
                        {% else %}
                            <span class="prem-icon-no" title="Free Account">✖</span>
                        {% endif %}
                    </td>

                    <!-- Spell Words -->
                    <td>
                        {% if spell.words %}
                            <span class="spell-formula-pill">{{ spell.words }}</span>
                        {% else %}
                            <span style="color: #94a3b8; font-style: italic;">Nenhuma</span>
                        {% endif %}
                    </td>

                    <!-- Mana -->
                    <td style="text-align: center;" data-order="{{ spell.mana == 'Var.' ? 9999 : spell.mana }}">
                        <span class="spell-mana-val">{{ spell.mana }}</span>
                        {% if spell.charges and spell.charges != '—' %}
                            <span style="font-size: 10px; color: #64748b;">({{ spell.charges }})</span>
                        {% endif %}
                    </td>

                    <!-- Grupo -->
                    <td>
                        {% set groupClass = 'group-suporte' %}
                        {% if 'Ataque' in spell.group %}{% set groupClass = 'group-ataque' %}
                        {% elseif 'Cura' in spell.group %}{% set groupClass = 'group-cura' %}
                        {% elseif 'Campo' in spell.group %}{% set groupClass = 'group-campo' %}
                        {% elseif 'Conjuração' in spell.group %}{% set groupClass = 'group-conjuracao' %}
                        {% endif %}
                        <span class="group-badge {{ groupClass }}">{{ spell.group }}</span>
                    </td>

                    <!-- Efeito -->
                    <td>
                        <div class="spell-effect-text">
                            {{ spell.effect|raw }}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>

<link rel="stylesheet" href="{{ base_url }}tools/css/datatables.min.css">
<script src="{{ base_url }}tools/js/datatables.min.js"></script>

<script>
$(document).ready(function() {
    // Inicializa DataTable com ordenação e paginação
    var table = $('#spellsTable').DataTable({
        "paging": true,
        "pageLength": 50,
        "lengthChange": false,
        "info": true,
        "autoWidth": false,
        "order": [[ 2, "asc" ]], // Ordena por ML inicialmente
        "language": {
            "search": "Buscar:",
            "info": "Mostrando _START_ a _END_ de _TOTAL_ magias",
            "infoEmpty": "Nenhuma magia encontrada",
            "infoFiltered": "(filtrado de _MAX_ magias)",
            "zeroRecords": "Nenhuma magia corresponde aos filtros aplicados",
            "paginate": {
                "first": "Primeira",
                "last": "Última",
                "next": "Próxima",
                "previous": "Anterior"
            }
        }
    });

    var currentTab = 'all';
    var currentVoc = $('#filter_vocation').val() || 'all';
    var currentGroup = 'all';
    var currentPrem = 'all';

    // Função de filtro customizada no DataTables
    $.fn.dataTable.ext.search.push(
        function(settings, data, dataIndex) {
            var rowNode = table.row(dataIndex).node();
            if (!rowNode) return true;

            var $row = $(rowNode);
            var rType = $row.data('type') || '';
            var rVoc = ($row.data('voc') || '').toLowerCase();
            var rGroup = $row.data('group') || '';
            var rPrem = $row.data('prem') || '';

            // Filtro de Aba (Type)
            if (currentTab !== 'all' && rType !== currentTab) {
                return false;
            }

            // Filtro de Vocação
            if (currentVoc !== 'all') {
                if (rVoc.indexOf(currentVoc) === -1) {
                    return false;
                }
            }

            // Filtro de Grupo
            if (currentGroup !== 'all') {
                if (rGroup.indexOf(currentGroup) === -1) {
                    return false;
                }
            }

            // Filtro de Premium
            if (currentPrem !== 'all' && rPrem !== currentPrem) {
                return false;
            }

            return true;
        }
    );

    // Abas
    $('.spells-tab-btn').on('click', function(e) {
        e.preventDefault();
        $('.spells-tab-btn').removeClass('active');
        $(this).addClass('active');
        currentTab = $(this).data('tab');
        table.draw();
    });

    // Filtro Vocação
    $('#filter_vocation').on('change', function() {
        currentVoc = $(this).val();
        table.draw();
    });

    // Filtro Grupo
    $('#filter_group').on('change', function() {
        currentGroup = $(this).val();
        table.draw();
    });

    // Filtro Premium
    $('#filter_prem').on('change', function() {
        currentPrem = $(this).val();
        table.draw();
    });

    // Busca rápida
    $('#spells_search').on('keyup', function() {
        table.search(this.value).draw();
    });

    // Se já havia vocação pré-selecionada na URL, aplica
    if (currentVoc !== 'all') {
        table.draw();
    }
});
</script>
