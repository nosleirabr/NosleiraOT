<style>
@keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
    100% { opacity: 1; }
}
.blink-green { color: green; font-weight: bold; animation: blink 1.5s infinite; }
.blink-red { color: red; font-weight: bold; animation: blink 1.5s infinite; }

.serverinfo-nav {
    text-align: center;
    font-weight: bold;
    padding: 8px;
    margin-bottom: 15px;
    background-color: #e3ceb0;
    border: 1px solid #000;
}
.serverinfo-nav a {
    text-decoration: none;
    color: #004294;
    margin: 0 5px;
    font-size: 12px;
}
.serverinfo-nav a:hover {
    text-decoration: underline;
}
.TableContainer .Table3 {
    width: 100%;
    border-collapse: collapse;
    border: 2px solid #f1e0c5;
}
.Table3 th {
    background-color: #505050;
    color: #fff;
    padding: 5px;
    text-align: left;
    font-weight: bold;
    border: 1px solid #faf0d7;
}
.Table3 td {
    border: 1px solid #faf0d7;
    padding: 4px;
}
.row-odd { background-color: #D4C0A1; }
.row-even { background-color: #F1E0C6; }
.td-name { width: 40%; font-weight: normal; color: #4a1c00; }
</style>

<div class="serverinfo-nav">
    <a href="#status">[Status]</a>
    <a href="#rates">[Rates]</a>
    <a href="#infoserver">[Info Server]</a>
    <a href="#commands">[Commands]</a>
    <a href="#frags">[Frags]</a>
    <a href="#other">[Other Information]</a>
</div>

<!-- STATUS -->
<a name="status"></a>
<div class="TableContainer">
    <div class="CaptionContainer">
        <div class="CaptionInnerContainer">
            <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <div class="Text">Status</div>
            <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        </div>
    </div>
    <div style="border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: 1px solid #000;"><table class="Table3" cellpadding="4" cellspacing="0">
        <tbody>
            <tr><th>Name</th><th>Value</th></tr>
            <tr class="row-even">
                <td class="td-name">Server</td>
                <td>
                    {% if serverOnline or serverPlayers > 0 %}
                        <span class="blink-green">Online</span>
                    {% else %}
                        <span class="blink-red">Offline</span>
                    {% endif %}
                </td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Players Online according to the rules of Otservlist</td>
                <td>{{ serverPlayers }}</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">UpTime</td>
                <td>{{ serverUptime }}</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Monster</td>
                <td>{{ monstersCount }}</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">NPC</td>
                <td>{{ npcsCount }}</td>
            </tr>
        </tbody>
    </table>
    </div>
</div>
<br>

<!-- RATES -->
<a name="rates"></a>
<div class="TableContainer">
    <div class="CaptionContainer">
        <div class="CaptionInnerContainer">
            <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <div class="Text">Rates</div>
            <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        </div>
    </div>
    <div style="border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: 1px solid #000;"><table class="Table3" cellpadding="4" cellspacing="0">
        <tbody>
            <tr><th>Name</th><th>Value</th></tr>
            <tr class="row-odd">
                <td class="td-name">Experiência</td>
                <td>
                    {% if experienceStages %}
                        <div style="display:flex; flex-wrap:wrap; gap:10px;">
                        {% for stage in experienceStages %}
                            <div style="background-color:#fff; border:1px solid #c7b499; border-radius:4px; padding:5px 10px; text-align:center; box-shadow:inset 0 0 3px rgba(0,0,0,0.1);">
                                <div style="font-size:11px; color:#505050;">{% if stage.maxlevel %}Lv {{ stage.minlevel }} to {{ stage.maxlevel }}{% else %}Lv {{ stage.minlevel }}+{% endif %}</div>
                                <div style="font-weight:bold; color:#004294;">{{ stage.multiplier }}x</div>
                            </div>
                        {% endfor %}
                        </div>
                    {% else %}
                        <span style="font-weight:bold; color:#004294;">{{ rateExp|default('1') }}x</span>
                    {% endif %}
                </td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Skill</td>
                <td><span style="font-weight:bold; color:#004294;">{{ rateSkill|default('1') }}x</span></td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Magic</td>
                <td><span style="font-weight:bold; color:#004294;">{{ rateMagic|default('1') }}x</span></td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Loot</td>
                <td><span style="font-weight:bold; color:#004294;">{{ rateLoot|default('1') }}x</span></td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Spawn</td>
                <td><span style="font-weight:bold; color:#004294;">{{ rateSpawn|default('1') }}x</span></td>
            </tr>
        </tbody>
    </table>
    </div>
</div>
<br>

<!-- INFO SERVER -->
<a name="infoserver"></a>
<div class="TableContainer">
    <div class="CaptionContainer">
        <div class="CaptionInnerContainer">
            <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <div class="Text">Info Server</div>
            <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        </div>
    </div>
    <div style="border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: 1px solid #000;"><table class="Table3" cellpadding="4" cellspacing="0">
        <tbody>
            <tr><th>Name</th><th>Value</th></tr>
            <tr class="row-even">
                <td class="td-name">IP</td>
                <td><a href="http://{{ serverIp }}" style="font-weight:bold; color:#004294; text-decoration:none;">{{ serverIp }}</a> (Port: {{ config.lua.loginPort }})</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">World Type</td>
                <td>{{ config.lua.worldType|title }}</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Client Version</td>
                <td>7.4</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Server Mode</td>
                <td><span style="font-weight:bold; color:#004294;">NosleiraOT</span></td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Last joined</td>
                <td>{% if dbStats.last_joined %}<a href="{{ getLink('characters/' ~ dbStats.last_joined) }}">{{ dbStats.last_joined }}</a>{% else %}None{% endif %}</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Best Level</td>
                <td>{% if dbStats.best_level_name != 'None' %}<a href="{{ getLink('characters/' ~ dbStats.best_level_name) }}">{{ dbStats.best_level_name }}</a> ({{ dbStats.best_level }}){% else %}None{% endif %}</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Free Houses</td>
                <td>{{ dbStats.houses_free }}</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Banned accounts</td>
                <td>{{ dbStats.banned }}</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Accounts in database</td>
                <td>{{ dbStats.accounts }}</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Players in database</td>
                <td>{{ dbStats.players }}</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Guilds in database</td>
                <td>{{ dbStats.guilds }}</td>
            </tr>
        </tbody>
    </table>
    </div>
</div>
<br>

<!-- COMMANDS -->
<a name="commands"></a>
<div class="TableContainer">
    <div class="CaptionContainer">
        <div class="CaptionInnerContainer">
            <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <div class="Text">Commands</div>
            <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        </div>
    </div>
    <div style="border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: 1px solid #000;"><table class="Table3" cellpadding="4" cellspacing="0">
        <tbody>
            <tr><th width="30%">Words</th><th>Description</th></tr>
            <tr class="row-even"><td class="td-name">!serverinfo</td><td>Shows the current server rates.</td></tr>
            <tr class="row-odd"><td class="td-name">!kills</td><td>Displays your current unjustified kills (frags).</td></tr>
            <tr class="row-even"><td class="td-name">!deathlist</td><td>Shows your recent death history.</td></tr>
            <tr class="row-odd"><td class="td-name">!pz</td><td>Displays the remaining time for your Protection Zone lock and/or Skull.</td></tr>
            <tr class="row-even"><td class="td-name">!buyhouse</td><td>Buy a house. Stand facing the door.</td></tr>
            <tr class="row-odd"><td class="td-name">!leavehouse</td><td>Leave your current house. Items stay in the house.</td></tr>
            <tr class="row-even"><td class="td-name">aleta sio</td><td>Edit the house guest list.</td></tr>
            <tr class="row-odd"><td class="td-name">aleta som</td><td>Edit the house sub-owner list.</td></tr>
            <tr class="row-even"><td class="td-name">aleta grav</td><td>Edit door permission list.</td></tr>
            <tr class="row-odd"><td class="td-name">alana sio</td><td>Kick a player from the house, or leave the house yourself.</td></tr>
        </tbody>
    </table>
    </div>
</div>
<br>

<!-- FRAGS -->
<a name="frags"></a>
<div class="TableContainer">
    <div class="CaptionContainer">
        <div class="CaptionInnerContainer">
            <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <div class="Text">Frags</div>
            <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        </div>
    </div>
    <div style="border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: 1px solid #000;"><table class="Table3" cellpadding="4" cellspacing="0">
        <tbody>
            <tr><th>Name</th><th>Value</th></tr>
            <tr class="row-even">
                <td class="td-name"><img src="images/white_skull.gif" style="vertical-align:middle; margin-right:5px;" alt="White Skull"/>White Skull Time</td>
                <td>{{ whiteSkullTime / (60 * 1000) }} minutes</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name"><img src="images/red_skull.gif" style="vertical-align:middle; margin-right:5px;" alt="Red Skull"/>Red Skull Time</td>
                <td>{{ redSkullLength / (24 * 60 * 60) }} days</td>
            </tr>
            {% if killsToBlackSkull %}
            <tr class="row-even">
                <td class="td-name"><img src="images/red_skull.gif" style="vertical-align:middle; margin-right:5px;" alt="Red Skull"/>Frags to Red Skull</td>
                <td>{{ killsToRedSkull|default('3') }} frags</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name"><img src="images/black_skull.gif" style="vertical-align:middle; margin-right:5px;" alt="Black Skull"/>Frags to Black Skull</td>
                <td>{{ killsToBlackSkull }} frags</td>
            </tr>
            <tr class="row-even">
                <td class="td-name"><img src="images/yellow_skull.gif" style="vertical-align:middle; margin-right:5px;" alt="Skull"/>Frags para Autoban (7 Dias)</td>
                <td><b>Dia:</b> {{ dailyKillsToBanishment|default('10') }} &nbsp;|&nbsp; <b>Semana:</b> {{ weeklyKillsToBanishment|default('15') }} &nbsp;|&nbsp; <b>M&ecirc;s:</b> {{ monthlyKillsToBanishment|default('25') }}</td>
            </tr>
            {% else %}
            <tr class="row-even">
                <td class="td-name"><img src="images/red_skull.gif" style="vertical-align:middle; margin-right:5px;" alt="Red Skull"/>Frags to Red Skull</td>
                <td>{{ killsToRedSkull|default('3') }} frags</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name"><img src="images/yellow_skull.gif" style="vertical-align:middle; margin-right:5px;" alt="Skull"/>Frags para Autoban (7 Dias)</td>
                <td><b>Dia:</b> {{ dailyKillsToBanishment|default('10') }} &nbsp;|&nbsp; <b>Semana:</b> {{ weeklyKillsToBanishment|default('15') }} &nbsp;|&nbsp; <b>M&ecirc;s:</b> {{ monthlyKillsToBanishment|default('25') }}</td>
            </tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</div>
<br>

<!-- OTHER INFORMATION -->
<a name="other"></a>
<div class="TableContainer">
    <div class="CaptionContainer">
        <div class="CaptionInnerContainer">
            <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
            <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <div class="Text">Other Information</div>
            <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
            <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
            <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        </div>
    </div>
    <div style="border-left: 1px solid #000; border-right: 1px solid #000; border-bottom: 1px solid #000;"><table class="Table3" cellpadding="4" cellspacing="0">
        <tbody>
            <tr><th>Name</th><th>Value</th></tr>
            <tr class="row-even">
                <td class="td-name">Premium Account</td>
                <td>Available via Webshop</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">PZ Lock</td>
                <td>{{ pzLocked / (60 * 1000) }} minutes</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Protection Level</td>
                <td>Level {{ protectionLevel }}</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Level to Buy House</td>
                <td>Level {{ houseLevel }}</td>
            </tr>
            <tr class="row-even">
                <td class="td-name">Level to Create Guild</td>
                <td>Level {{ setting('core.guild_need_level') }}</td>
            </tr>
            <tr class="row-odd">
                <td class="td-name">Guild Houses</td>
                <td>Enabled</td>
            </tr>
        </tbody>
    </table>
    </div>
</div>
<br>

