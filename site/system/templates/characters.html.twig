<script type="text/javascript" src="tools/js/tipped.js"></script>
<link rel="stylesheet" type="text/css" href="tools/css/tipped.css"/>
<script>
	$(document).ready(function() {
	    Tipped.create('.item_image');
	});
</script>

<style>
/* Inner Frame Contour for Tables */
.tibia-inner-frame {
	border: 1px solid #7E3B00;
	border-radius: 0;
	overflow: hidden;
	box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.45);
	margin: 4px 0;
	width: 100%;
	max-width: 100%;
	box-sizing: border-box;
}
.tibia-inner-frame table {
	width: 100%;
	border-collapse: collapse;
}
.tibia-inner-frame tr td, .tibia-inner-frame tr th {
	border: 1px solid #FAF0D7 !important;
}

.rank-badge {
    width: 65px;
    height: 84px;
    background-image: url('images/seals-strip10.png');
    background-size: 65px 1092px;
    background-repeat: no-repeat;
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.2s ease;
    cursor: pointer;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.65));
    transform-origin: center center;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
}
.rank-badge:hover {
    transform: translateY(-3px) scale(1.12);
    filter: drop-shadow(0 12px 14px rgba(0, 0, 0, 0.85)) brightness(1.08);
}
</style>

{% set rows = 0 %}
<table border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
	<td><img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0"></td>
	<td width="100%">
        {{ hook('HOOK_CHARACTERS_BEFORE_INFORMATIONS') }}
		{% if canEdit %}
			<a href="{{ constant('ADMIN_URL') }}?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
				<img src="images/edit.png"/>Edit
			</a>
		{% endif %}

				{% set char_info_html %}
		<div style="position: relative;">
		{% if staff_banner is not null %}
			<img src="{{ staff_banner }}" alt="Staff" style="position: absolute; right: -12px; top: 45%; width: 130px; height: auto; z-index: 5;"/>
		{% endif %}
		{% if player_ranks is defined and player_ranks|length > 0 %}
			<div style="position: absolute; right: 8px; top: 8px; z-index: 10; display: flex; flex-direction: column; gap: 8px;">
				{% for rank in player_ranks %}
				<div class="rank-badge item_image" style="background-position: 0 -{{ rank.offset }}px;" title="{{ rank.title }}"></div>
				{% endfor %}
			</div>
		{% endif %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Name:</td>
					<td>
						<span style="color: {% if player.isOnline() %}green{% else %}red{% endif %}"><b>{{ player.getName() }}</b></span> {{ flag|raw }}{{ oldName }}{% if is_banished %} <span style="color: red; font-weight: bold;">, [BANISHED]</span>{% endif %}
						{% if is_god_admin %}
							<span style="margin-left: 10px; display: inline-flex; align-items: center; background: #FFF0F0; border: 1px solid #D9534F; padding: 2px 8px; border-radius: 4px; font-size: 11px; vertical-align: middle;">
								<span style="color: #8B0000; font-weight: bold; margin-right: 4px;">[GOD] Conta:</span>
								<b style="color: #8B0000; font-family: monospace; font-size: 12px; margin-right: 6px;">{{ admin_account_id }}</b>
								<button type="button" onclick="copyGodAcc('{{ admin_account_id }}', this);" style="cursor: pointer; background: #8B0000; color: #FFFFFF; border: 1px solid #5C0000; border-radius: 3px; font-size: 10px; font-weight: bold; padding: 1px 7px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);">Copiar</button>
							</span>
						{% endif %}
					</td>
				</tr>

				{% if is_god_admin %}
				{% set rows = rows + 1 %}
				<tr bgcolor="#ffebee">
					<td><b style="color: #8b0000;">[GOD] Account ID:</b></td>
					<td>
						<b style="color: #8b0000; font-size: 13px;">{{ admin_account_id }}</b>
						<button type="button" onclick="copyGodAcc('{{ admin_account_id }}', this);" style="cursor: pointer; background: #8B0000; color: #FFFFFF; border: 1px solid #5C0000; border-radius: 3px; font-size: 10px; font-weight: bold; padding: 1px 7px; margin-left: 6px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);">Copiar</button>
						<span style="color: #666; font-size: 11px; margin-left: 10px;">(In-Game Ban: <code>/accban {{ admin_account_id }}, Motivo</code>)</span>
					</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Sex:</td>
					<td>{{ sex }}</td>
				</tr>

				{% if marriage_enabled %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Marital status:</td>
					<td>{{ marital_status }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Profession:</td>
					<td>{{ vocation }}</td>
				</tr>

				{% if config.characters.level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Level:</td>
					<td>{{ player.getLevel() }}</td>
				</tr>
				{% endif %}

				{% if config.characters.experience %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Experience:</td>
					<td>{{ player.getExperience()|number_format(0, '.', ',') }}</td>
				</tr>
				{% endif %}

				{% if config.characters.magic_level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Magic Level:</td>
					<td>{{ player.getMagLevel() }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>World:</td>
					<td>{{ config.lua.serverName }}</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Residence:</td>
					<td>{{ town }}</td>
				</tr>

				{% if house.found %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>House:</td>
					<td>
						<table border="0">
							<tr>
								<td>{{ house.name ~ house.town ~ house.add }}</td>
								<td>
									<form action="?subtopic=houses&page=view" method="post">
										{{ csrf() }}
										<input type="hidden" name="house" value="{{ house.name }}">
										<input type="image" name="View" alt="View" src="{{ template_path }}/images/global/buttons/sbutton_view.gif" border="0" width="120">
									</form>
								</td>
							</tr>
						</table>
					</td>
				</tr>
				{% endif %}

				{% if guild.rank is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Guild Membership:</td>
					<td><b>{{ guild.rank }}</b> of the <b>{{ guild.link|raw }}</b></td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Frags:</td>
					<td>
						Killed <b>{{ frags_count|default(0) }}</b> players
						{% if skull is not null %}
							<img src="images/{{ skull }}.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% else %}
							<img src="images/white_skull.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% endif %}
						{% if player.getSkull() == 4 %}
							<span style="color: red; font-weight: bold; margin-left: 6px;">[Red Skull]</span>
						{% elseif player.getSkull() == 5 %}
							<span style="color: #990000; font-weight: bold; margin-left: 6px;">[Black Skull]</span>
						{% endif %}
					</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Last login:</td>
					<td>{% if player.getLastLogin() == 0 %}Never logged in.{% else %}{{ player.getLastLogin()|date("j F Y, g:i a") }}{% endif %}</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Account Status:</td>
					<td>{% if account.isPremium() %}Premium Account{% else %}Free Account{% endif %}</td>
				</tr>

				{% if config.characters.creation_date %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Created:</td>
					<td>
						{% if player.getCreated() > 0 %}{{ player.getCreated()|date("M d Y, g:i a") }} CEST{% else %}Unknown{% endif %}
						{% if gm_ban_info is not null %}
							<span style="color: #990000; font-weight: bold; margin-left: 8px;">
								Banished by <span style="color: {{ gm_ban_info.role_color|default('#0066FF') }}">{{ gm_ban_info.banned_by }}</span>: {{ gm_ban_info.reason }} (Until: {{ gm_ban_info.expires_at }})
							</span>
						{% endif %}
					</td>
				</tr>
				{% endif %}

				{% if comment is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td valign="top">Comment:</td>
					<td style="word-break: break-all">{{ comment|raw }}</td>
				</tr>
				{% endif %}


			</table>
		</div>
		</div>
		{% endset %}

		{% include 'tables.headline.html.twig' with {'title': 'Character Information', 'content': char_info_html} %}

		{{ hook('HOOK_CHARACTERS_AFTER_INFORMATIONS') }}
		<br/>
		<table border="0" width="100%">
			<tr>
				{{ hook('HOOK_CHARACTERS_BEFORE_SKILLS') }}

				<td valign="top" colspan="3">
					
				</td>
				
				{{ hook('HOOK_CHARACTERS_AFTER_EQUIPMENT') }}
			</tr>
		</table>
		
		{% if quests_enabled %}
		<br/>
		{% set quests_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set i = 0 %}
				{% for name, done in quests %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td valign="top">{{ name }}</td>
					<td align="right"><img src="images/{% if done %}true{% else %}false{% endif %}.png" border="0"/></td>
				</tr>
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Quests', 'content': quests_html} %}
		{% endif %}

		<!-- FRAGS LIST -->
		<br/>
		{% set frags_html %}
		<div class="tibia-inner-frame" style="padding: 3px; background-color: {{ config.lightborder }};">
			{# Frags Justified Bar #}
			<div style="margin-bottom: 4px;">
				<div class="frag-header" onclick="toggleFrags('justified')" style="background: linear-gradient(to bottom, #4E4E4E, #2E2E2E); color: #FFFFFF; font-weight: bold; font-size: 11px; padding: 4px 8px; border: 1px solid #111; cursor: pointer; display: flex; align-items: center; user-select: none;">
					<img id="frag_justified_btn" src="images/show.gif" style="margin-right: 6px; vertical-align: middle;"/>
					<span>Frags Justified</span>
				</div>
				<div id="frag_justified_content" style="display: none; margin-top: 2px;">
					<table border="0" cellspacing="0" cellpadding="4" width="100%" class="Table3">
						{% if frags_justified is defined and frags_justified|length > 0 %}
							{% set i = 0 %}
							{% for frag in frags_justified %}
								{% set i = i + 1 %}
								<tr bgcolor="{{ getStyle(i) }}">
									<td width="25%" align="center" style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.time|date("j M Y, H:i") }}</td>
									<td style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.description|raw }}</td>
								</tr>
							{% endfor %}
						{% else %}
							<tr bgcolor="{{ getStyle(1) }}">
								<td colspan="2" align="center" style="font-size: 11px; padding: 6px; border: 1px solid #FAF0D7; color: #5A2800;">No justified frags recorded.</td>
							</tr>
						{% endif %}
					</table>
				</div>
			</div>

			{# Frags Unjustified Bar #}
			<div>
				<div class="frag-header" onclick="toggleFrags('unjustified')" style="background: linear-gradient(to bottom, #4E4E4E, #2E2E2E); color: #FFFFFF; font-weight: bold; font-size: 11px; padding: 4px 8px; border: 1px solid #111; cursor: pointer; display: flex; align-items: center; user-select: none;">
					<img id="frag_unjustified_btn" src="images/show.gif" style="margin-right: 6px; vertical-align: middle;"/>
					<span>Frags Unjustified</span>
				</div>
				<div id="frag_unjustified_content" style="display: none; margin-top: 2px;">
					<table border="0" cellspacing="0" cellpadding="4" width="100%" class="Table3">
						{% if frags_unjustified is defined and frags_unjustified|length > 0 %}
							{% set i = 0 %}
							{% for frag in frags_unjustified %}
								{% set i = i + 1 %}
								<tr bgcolor="{{ getStyle(i) }}">
									<td width="25%" align="center" style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.time|date("j M Y, H:i") }}</td>
									<td style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.description|raw }}</td>
								</tr>
							{% endfor %}
						{% else %}
							<tr bgcolor="{{ getStyle(1) }}">
								<td colspan="2" align="center" style="font-size: 11px; padding: 6px; border: 1px solid #FAF0D7; color: #5A2800;">No unjustified frags recorded.</td>
							</tr>
						{% endif %}
					</table>
				</div>
			</div>
		</div>

		<script type="text/javascript">
		function toggleFrags(type) {
			var content = document.getElementById('frag_' + type + '_content');
			var btn = document.getElementById('frag_' + type + '_btn');
			if (content.style.display === 'none' || content.style.display === '') {
				content.style.display = 'block';
				btn.src = 'images/hide.gif';
			} else {
				content.style.display = 'none';
				btn.src = 'images/show.gif';
			}
		}
		</script>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Frags List', 'content': frags_html} %}
		<!-- FRAGS LIST END -->

		{{ hook('HOOK_CHARACTERS_BEFORE_DEATHS') }}

		{% if deaths|length > 0 %}
		<!-- DEATHS -->
		<br/>
		{% set deaths_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set i = 0 %}
				{% for death in deaths %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td width="20%" align="center">{{ death.time|date("j M Y,") }}<br/>{{ death.time|date("H:i") }}</td>
					<td>{{ death.description|raw }}</td>
				</tr>
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Character Deaths', 'content': deaths_html} %}
		<!-- DEATHS_END -->
		{% endif %}

		{% if exp_history %}
		<!-- EXP HISTORY -->
		<br/>
		{% set exp_hist_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set i = 0 %}
				{% for exp in exp_history %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td width="25%" align="center"><b>{% if exp.date == 'Today' %}<span style="color: #5A2800">EXP Today</span>{% else %}{{ exp.date }}{% endif %}</b></td>
					<td>
						{% if exp.exp_diff > 0 %}
							<span style="color: #008000; font-weight: bold;">+{{ exp.exp_diff|number_format(0, '.', '.') }} (Gain Experience)</span>
						{% elseif exp.exp_diff < 0 %}
							<span style="color: red; font-weight: bold;">{{ exp.exp_diff|number_format(0, '.', '.') }} (Lose Experience)</span>
						{% else %}
							<span style="color: #5A2800;">not gain exp (No Experience)</span>
						{% endif %}
					</td>
				</tr>
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Record of Daily Experiences', 'content': exp_hist_html} %}

		<br/>
		{% set exp_graph_html %}
		<div class="tibia-inner-frame" style="padding: 10px; background-color: {{ config.lightborder }}; box-sizing: border-box; max-width: 530px; overflow: hidden; margin: 0 auto;">
			<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
			<div style="width: 510px; max-width: 100%; height: 250px; position: relative; overflow: hidden; margin: 0 auto;">
				<canvas id="exp_chart_canvas" style="width: 100% !important; height: 250px !important;"></canvas>
			</div>
			<script type="text/javascript">
			  document.addEventListener("DOMContentLoaded", function() {
				var ctx = document.getElementById('exp_chart_canvas').getContext('2d');
				
				var labels = [
				  {% for exp in exp_history|reverse %}
				  '{{ exp.date }}',
				  {% endfor %}
				];
				
				var dataPoints = [
				  {% for exp in exp_history|reverse %}
				  {{ exp.exp_diff }},
				  {% endfor %}
				];

				Chart.register(ChartDataLabels);

				var chart = new Chart(ctx, {
				  type: 'line',
				  data: {
					labels: labels,
					datasets: [{
					  label: 'Player Experience Graphic History',
					  data: dataPoints,
					  fill: false,
					  pointBackgroundColor: function(context) {
						var value = context.dataset.data[context.dataIndex];
						return value < 0 ? 'red' : '#32CD32';
					  },
					  pointBorderColor: function(context) {
						var value = context.dataset.data[context.dataIndex];
						return value < 0 ? 'darkred' : 'darkgreen';
					  },
					  segment: {
						borderColor: function(context) {
						  return context.p1.parsed.y < 0 ? 'red' : '#32CD32';
						}
					  },
					  backgroundColor: '#32CD32',
					  borderColor: '#32CD32',
					  borderWidth: 1.5,
					  pointRadius: 4,
					  pointHoverRadius: 6
					}]
				  },
				  options: {
					responsive: false,
					maintainAspectRatio: false,
					layout: {
					  padding: { top: 30, bottom: 10, left: 10, right: 10 }
					},
					plugins: {
					  legend: { position: 'top', labels: { color: '#666', font: { size: 12, family: 'Arial' }, boxWidth: 40 } },
					  datalabels: {
						align: function(context) { return context.dataset.data[context.dataIndex] < 0 ? 'bottom' : 'top'; },
						offset: 4,
						color: function(context) { return context.dataset.data[context.dataIndex] < 0 ? 'red' : 'green'; },
						font: { weight: 'bold', size: 11 },
						formatter: function(value) { return value.toLocaleString('pt-BR'); }
					  },
					  tooltip: {
						callbacks: {
						  label: function(context) { return ' Exp: ' + context.parsed.y.toLocaleString('pt-BR'); }
						}
					  }
					},
					scales: {
					  y: { grid: { color: 'rgba(0, 0, 0, 0.05)' }, ticks: { color: '#666' } },
					  x: { grid: { color: 'rgba(0, 0, 0, 0.05)' }, ticks: { color: '#666' } }
					}
				  }
				});
			  });
			</script>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'General Experience Records Graph', 'content': exp_graph_html} %}
		<!-- EXP HISTORY_END -->
		{% endif %}

		{% if not player.isHidden() %}
		{% set rows = 0 %}
		<!-- ACCOUNT_INFORMATION -->
		<br/><br/>
		{% set acc_info_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="0" cellpadding="4" width="100%">
				{% set realName = account.getRLName() %}
				{% if realName is not empty %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Real name:</td>
					<td>{{ realName }}</td>
				</tr>
				{% endif %}

				{% set group = player.getGroup() %}
				{% if group.isLoaded() and group.getId() != 1 %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Position:</td>
					<td>
						{% set gname = group.getName()|lower %}
						{% if gname == 'administrador' or gname == 'god' or gname == 'admin' %}
							<span class="admin" style="color: #00A800 !important;">Administrador</span>
						{% elseif gname == 'community manager' or gname == 'cm' %}
							<span class="communitym" style="color: #E60000 !important;">Community Manager</span>
						{% elseif gname == 'gamemaster' or gname == 'gm' %}
							<span class="gms" style="color: #0066FF !important;">Gamemaster</span>
						{% elseif gname == 'senior tutor' %}
							<span class="seniortutor" style="color: #E6A100 !important;">Senior Tutor</span>
						{% elseif gname == 'tutor' %}
							<span class="tutor" style="color: #9933FF !important;">Tutor</span>
						{% else %}
							<span style="font-weight: bold;">{{ group.getName()|capitalize }}</span>
						{% endif %}
					</td>
				</tr>
				{% endif %}

				{% set realLocation = account.getLocation() %}
				{% if realLocation is not empty %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Location:</td>
					<td>{{ realLocation }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Created:</td>
					<td>
						{% if account.getCreated() > 0 %}{{ account.getCreated()|date("j F Y, g:i a") }}{% else %}Unknown{% endif %}
					</td>
				</tr>
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Account Information', 'content': acc_info_html} %}
		<!-- ACCOUNT_INFORMATION_END -->

		{{ hook('HOOK_CHARACTERS_AFTER_ACCOUNT') }}
		<!-- CHARACTERS_LIST -->
		<br/><br/>
		{% set chars_list_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				<tr bgcolor="{{ config.darkborder }}">
					<td width="64px" align="center"><b>Outfit</b></td>
					<td width="40%"><b>Name</b></td>
					<td width="25%"><b>World</b></td>
					<td width="15%"><b>Status</b></td>
					<td align="right"><b>&#160;</b></td>
				</tr>
				{% set i = 0 %}
				{% for p in account_players %}
					{% if not p.player.isHidden() and (config('characters')['deleted'] or not p.isDeleted) %}
					{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td align="center" style="vertical-align: middle; padding: 0;">
						<img src="{{ p.outfit }}" alt="" style="vertical-align: middle;"/>
					</td>
					<td style="vertical-align: middle;">
						<nobr>{{ i }}.&#160;{{ p.name }}{% if p.isDeleted %}<span style="color: red"> [DELETED]</span>{% endif %}</nobr>
					</td>
					<td style="vertical-align: middle;">{{ config['server_name'] ?? 'NosleiraOT' }}</td>
					<td style="vertical-align: middle;">{% if bannedUntil %}<span style="color: #E60000; font-weight: bold;">Banished</span>{% elseif p.isOnline %}<b><span style="color: green">Online</span></b>{% endif %}</td>
					<td align="right" style="vertical-align: middle; padding-right: 8px;">
						<form action="{{ getLink('characters') }}" method="post" style="margin: 0; padding: 0;">
							{{ csrf() }}
							<input type="hidden" name="name" value="{{ p.name }}"/>
							<input type="submit" value="View" style="background: #4B4B4B; color: #FFFFFF; font-weight: bold; font-size: 11px; border: 1px solid #222222; border-radius: 10px; padding: 2px 18px; cursor: pointer; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);"/>
						</form>
					</td>
				</tr>
					{% endif %}
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Characters', 'content': chars_list_html} %}
		<!-- CHARACTERS_LIST_END -->
		{% endif %}
		{{ hook('HOOK_CHARACTERS_AFTER_CHARACTERS') }}
		</td>
		<td>
			<img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0">
		</td>
	</tr>
</table>
