<script type="text/javascript" src="tools/js/tipped.js"></script>
<link rel="stylesheet" type="text/css" href="tools/css/tipped.css"/>
<script>
	$(document).ready(function() {
	    Tipped.create('.item_image');
	});
</script>

<style>
/* Inner Frame Contour for Tables */
.tibia-inner-frame {
	border: 1px solid #7A5726;
	border-radius: 4px;
	overflow: hidden;
	box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
	margin: 4px 0;
	width: 100%;
	max-width: 100%;
	box-sizing: border-box;
}

</style>

{% set rows = 0 %}
<table border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
	<td><img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0"></td>
	<td width="100%">
        {{ hook('HOOK_CHARACTERS_BEFORE_INFORMATIONS') }}
		{% if canEdit %}
			<a href="{{ constant('ADMIN_URL') }}?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
				<img src="images/edit.png"/>Edit
			</a>
		{% endif %}

		{% set char_info_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Name:</td>
					<td>
						<span style="color: {% if player.isOnline() %}green{% else %}red{% endif %}"><b>{{ player.getName() }}</b></span> {{ flag|raw }}{{ oldName }}
						
						{% set gname = player.getGroup().getName()|lower %}
						{% set gid = player.getGroup().getId() %}
						{% if gid > 1 or gname in ['administrador', 'god', 'admin', 'community manager', 'cm', 'gamemaster', 'gm', 'senior tutor', 'tutor'] %}
							{% if gname == 'administrador' or gname == 'god' or gname == 'admin' %}
								<span class="admin" style="color: #00A800; font-weight: bold; margin-left: 6px;">[Administrador]</span>
							{% elseif gname == 'community manager' or gname == 'cm' %}
								<span class="communitym" style="color: #E60000; font-weight: bold; margin-left: 6px;">[Community Manager]</span>
							{% elseif gname == 'gamemaster' or gname == 'gm' %}
								<span class="gms" style="color: #0066FF; font-weight: bold; margin-left: 6px;">[Gamemaster]</span>
							{% elseif gname == 'senior tutor' %}
								<span class="seniortutor" style="color: #E6A100; font-weight: bold; margin-left: 6px;">[Senior Tutor]</span>
							{% elseif gname == 'tutor' %}
								<span class="tutor" style="color: #9933FF; font-weight: bold; margin-left: 6px;">[Tutor]</span>
							{% endif %}
						{% endif %}
					</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Sex:</td>
					<td>{{ sex }}</td>
				</tr>

				{% if marriage_enabled %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Marital status:</td>
					<td>{{ marital_status }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Profession:</td>
					<td>{{ vocation }}</td>
				</tr>

				{% if config.characters.level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Level:</td>
					<td>{{ player.getLevel() }}</td>
				</tr>
				{% endif %}

				{% if config.characters.experience %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Experience:</td>
					<td>{{ player.getExperience()|number_format(0, '.', ',') }}</td>
				</tr>
				{% endif %}

				{% if config.characters.magic_level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Magic Level:</td>
					<td>{{ player.getMagLevel() }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Account Status:</td>
					<td>{% if account.isPremium() %}Premium Account{% else %}Free Account{% endif %}</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Frags:</td>
					<td>
						Killed <b>{{ frags_count|default(0) }}</b> players
						{% if skull is not null %}
							<img src="images/{{ skull }}.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% else %}
							<img src="images/white_skull.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% endif %}
						{% if player.getSkull() == 4 %}
							<span style="color: red; font-weight: bold; margin-left: 6px;">[Red Skull]</span>
						{% elseif player.getSkull() == 5 %}
							<span style="color: #990000; font-weight: bold; margin-left: 6px;">[Black Skull]</span>
						{% endif %}
					</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Residence:</td>
					<td>{{ town }}</td>
				</tr>

				{% if house.found %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>House:</td>
					<td>
						<table border="0">
							<tr>
								<td>{{ house.name ~ house.town ~ house.add }}</td>
								<td>
									<form action="?subtopic=houses&page=view" method="post">
										{{ csrf() }}
										<input type="hidden" name="house" value="{{ house.name }}">
										<input type="image" name="View" alt="View" src="{{ template_path }}/images/global/buttons/sbutton_view.gif" border="0" width="120">
									</form>
								</td>
							</tr>
						</table>
					</td>
				</tr>
				{% endif %}

				{% if guild.rank is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Guild membership:</td>
					<td>{{ guild.rank }} of the {{ guild.link|raw }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Last login:</td>
					<td>{% if player.getLastLogin() == 0 %}Never logged in.{% else %}{{ player.getLastLogin()|date("M d Y, H:i:s") }} CEST{% endif %}</td>
				</tr>

				{% if config.characters.creation_date %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Created:</td>
					<td>
						{{ player.getCreated()|date("M d Y, g:i a") }} CEST
						{% if gm_ban_info is not null %}
							<span style="color: red; font-weight: bold; margin-left: 8px;">
								[Banished by GM {{ gm_ban_info.banned_by }}: {{ gm_ban_info.reason }} (Until: {{ gm_ban_info.expires_at }})]
							</span>
						{% endif %}
					</td>
				</tr>
				{% endif %}

				{% if comment is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td valign="top">Comment:</td>
					<td style="word-break: break-all">{{ comment|raw }}</td>
				</tr>
				{% endif %}
			</table>
		</div>
		{% endset %}

		{% include 'tables.headline.html.twig' with {'title': 'Character Information', 'content': char_info_html} %}

		{{ hook('HOOK_CHARACTERS_AFTER_INFORMATIONS') }}
		<br/>
		<table border="0" width="100%">
			<tr>
				{{ hook('HOOK_CHARACTERS_BEFORE_SKILLS') }}

				<td valign="top" colspan="3">
					<!-- TIBIA UI START -->
					<style>
					.tibia-ui {
						display: flex;
						flex-wrap: wrap;
						gap: 15px;
						padding: 15px;
						background: #3A3A3A;
						border: 1px solid #111;
						font-family: Tahoma, sans-serif;
						font-size: 11px;
						color: #C0C0C0;
						justify-content: center;
					}
					.tibia-window {
						background: #363636;
						border-top: 1px solid #5A5A5A;
						border-left: 1px solid #5A5A5A;
						border-bottom: 1px solid #111;
						border-right: 1px solid #111;
						width: 175px;
						box-shadow: 1px 1px 2px rgba(0,0,0,0.5);
					}
					.tibia-window-header {
						background: #363636;
						border-bottom: 1px solid #111;
						padding: 2px 4px;
						display: flex;
						justify-content: space-between;
						align-items: center;
						color: #C0C0C0;
						cursor: pointer;
					}
					.tibia-window-content {
						padding: 5px;
						background: #3A3A3A;
						border-top: 1px solid #5A5A5A;
					}
					/* Health/Mana Bars */
					.tibia-bar-container {
						margin-bottom: 4px;
						background: #000;
						height: 12px;
						border: 1px solid #111;
						position: relative;
					}
					.tibia-bar-hp {
						background: #D82828;
						height: 100%;
					}
					.tibia-bar-mana {
						background: #4848D8;
						height: 100%;
					}
					.tibia-bar-text {
						position: absolute;
						top: -1px;
						right: 3px;
						font-size: 10px;
						color: #FFF;
						text-shadow: 1px 1px 0 #000;
					}
					/* Inventory Slots */
					.tibia-eq-grid {
						display: grid;
						grid-template-columns: 34px 34px 34px;
						grid-gap: 4px;
						justify-content: center;
						margin-bottom: 5px;
					}
					.tibia-slot {
						width: 34px;
						height: 34px;
						background: #2B2B2B;
						border-top: 1px solid #000;
						border-left: 1px solid #000;
						border-bottom: 1px solid #5A5A5A;
						border-right: 1px solid #5A5A5A;
						display: flex;
						align-items: center;
						justify-content: center;
					}
					/* Equipment positioning */
					.slot-neck { grid-column: 1; grid-row: 1; }
					.slot-head { grid-column: 2; grid-row: 1; }
					.slot-back { grid-column: 3; grid-row: 1; }
					.slot-left { grid-column: 1; grid-row: 2; }
					.slot-armor { grid-column: 2; grid-row: 2; }
					.slot-right { grid-column: 3; grid-row: 2; }
					.slot-ring { grid-column: 1; grid-row: 3; }
					.slot-legs { grid-column: 2; grid-row: 3; }
					.slot-ammo { grid-column: 3; grid-row: 3; }
					.slot-soul { grid-column: 1; grid-row: 4; text-align:center; padding-top:4px; font-size:10px; background: transparent; border: none; }
					.slot-boots { grid-column: 2; grid-row: 4; }
					.slot-cap { grid-column: 3; grid-row: 4; text-align:center; padding-top:4px; font-size:10px; background: transparent; border: none;}
					
					/* Skills */
					.tibia-skill-row {
						display: flex;
						justify-content: space-between;
						margin-bottom: 2px;
					}
					.tibia-skill-name { color: #C0C0C0; }
					.tibia-skill-val { color: #C0C0C0; text-align: right; }
					.tibia-skill-sep { border-bottom: 1px solid #111; margin: 4px 0; border-top: 1px solid #5A5A5A; }
					
					/* Outfits */
					.tibia-outfit-box {
						width: 128px;
						height: 128px;
						margin: 0 auto;
						display: flex;
						align-items: center;
						justify-content: center;
						position: relative;
					}
					.tibia-outfit-box img {
						width: 128px;
						height: 128px;
						margin-left: -32px;
						margin-top: -32px;
					}
					</style>

					<script>
					function toggleWindow(id) {
						var el = document.getElementById(id);
						if(el.style.display == 'none') el.style.display = 'block';
						else el.style.display = 'none';
					}
					</script>

					<div style="margin-bottom: 5px;">
						<button style="background: #2b2b2b; color: #fff; border: 1px solid #111; border-top: 1px solid #5a5a5a; border-left: 1px solid #5a5a5a; padding: 2px 5px; cursor: pointer;" onclick="toggleWindow('win-inventory')">Hide/Show Inventory</button>
					</div>

					<div class="tibia-ui">
						<!-- Inventory -->
						<div class="tibia-window" id="win-inventory" style="display:none;">
							<div class="tibia-window-header" onclick="toggleWindow('win-inventory')">
								<div><img src="images/general/blank.gif" width="10" height="10" style="background:#555; border:1px solid #111;"/> Inventory</div>
								<div>x</div>
							</div>
							<div class="tibia-window-content">
								<div class="tibia-bar-container">
									{% set hp_percent = (player.getHealthMax() > 0) ? (player.getHealth() / player.getHealthMax()) * 100 : 0 %}
									<div class="tibia-bar-hp" style="width: {{ hp_percent }}%;"></div>
									<div class="tibia-bar-text">{{ player.getHealth() }}</div>
								</div>
								<div class="tibia-bar-container">
									{% set mana_percent = (player.getManaMax() > 0) ? (player.getMana() / player.getManaMax()) * 100 : 0 %}
									<div class="tibia-bar-mana" style="width: {{ mana_percent }}%;"></div>
									<div class="tibia-bar-text">{{ player.getMana() }}</div>
								</div>
								
								<div class="tibia-eq-grid">
									<div class="tibia-slot slot-neck">{{ equipment[2]|raw }}</div>
									<div class="tibia-slot slot-head">{{ equipment[1]|raw }}</div>
									<div class="tibia-slot slot-back">{{ equipment[3]|raw }}</div>
									<div class="tibia-slot slot-left">{{ equipment[6]|raw }}</div>
									<div class="tibia-slot slot-armor">{{ equipment[4]|raw }}</div>
									<div class="tibia-slot slot-right">{{ equipment[5]|raw }}</div>
									<div class="tibia-slot slot-ring">{{ equipment[9]|raw }}</div>
									<div class="tibia-slot slot-legs">{{ equipment[7]|raw }}</div>
									<div class="tibia-slot slot-ammo">{{ equipment[10]|raw }}</div>
									<div class="tibia-slot slot-soul">{% if skull is not null %}<img src="images/{{ skull }}.gif">{% endif %}</div>
									<div class="tibia-slot slot-boots">{{ equipment[8]|raw }}</div>
									<div class="tibia-slot slot-cap">Cap:<br/>{{ player.getCapacity() }}</div>
								</div>
							</div>
						</div>

						<!-- Skills -->
						<div class="tibia-window">
							<div class="tibia-window-header" onclick="toggleWindow('win-skills')">
								<div><img src="images/general/blank.gif" width="10" height="10" style="background:#555; border:1px solid #111;"/> Skills</div>
								<div>_</div>
							</div>
							<div class="tibia-window-content" id="win-skills">
								<div class="tibia-skill-row"><span class="tibia-skill-name">Experience</span><span class="tibia-skill-val">{{ player.getExperience() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Level</span><span class="tibia-skill-val">{{ player.getLevel() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Hit Points</span><span class="tibia-skill-val">{{ player.getHealth() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Mana</span><span class="tibia-skill-val">{{ player.getMana() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Capacity</span><span class="tibia-skill-val">{{ player.getCapacity() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Magic Level</span><span class="tibia-skill-val">{{ player.getMagLevel() }}</span></div>
								<div class="tibia-skill-sep"></div>
								{% for skill in skills %}
								<div class="tibia-skill-row"><span class="tibia-skill-name">{{ skill.name }}</span><span class="tibia-skill-val">{{ skill.value }}</span></div>
								{% endfor %}
							</div>
						</div>

						<!-- Outfits -->
						<div class="tibia-window">
							<div class="tibia-window-header" onclick="toggleWindow('win-outfits')">
								<div><img src="images/general/blank.gif" width="10" height="10" style="background:#555; border:1px solid #111;"/> Outfits</div>
								<div>_</div>
							</div>
							<div class="tibia-window-content" id="win-outfits">
								<div class="tibia-outfit-box">
									{% if config.characters.outfit %}
									<img src="{{ outfit }}" alt="player outfit"/>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
					<!-- TIBIA UI END -->
				</td>
				
				{{ hook('HOOK_CHARACTERS_AFTER_EQUIPMENT') }}
			</tr>
		</table>
		
		{% if quests_enabled %}
		<br/>
		{% set quests_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set i = 0 %}
				{% for name, done in quests %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td valign="top">{{ name }}</td>
					<td align="right"><img src="images/{% if done %}true{% else %}false{% endif %}.png" border="0"/></td>
				</tr>
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Quests', 'content': quests_html} %}
		{% endif %}

		{{ hook('HOOK_CHARACTERS_BEFORE_DEATHS') }}

		{% if deaths|length > 0 %}
		<!-- DEATHS -->
		<br/>
		{% set deaths_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set i = 0 %}
				{% for death in deaths %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td width="20%" align="center">{{ death.time|date("j M Y, H:i") }}</td>
					<td>{{ death.description|raw }}</td>
				</tr>
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Character Deaths', 'content': deaths_html} %}
		<!-- DEATHS_END -->
		{% endif %}

		{% if exp_history %}
		<!-- EXP HISTORY -->
		<br/>
		{% set exp_hist_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set i = 0 %}
				{% for exp in exp_history %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td width="25%" align="center"><b>{% if exp.date == 'Today' %}<span style="color: #5A2800">EXP Today</span>{% else %}{{ exp.date }}{% endif %}</b></td>
					<td>
						{% if exp.exp_diff > 0 %}
							<span style="color: #008000; font-weight: bold;">+{{ exp.exp_diff|number_format(0, '.', '.') }} (Gain Experience)</span>
						{% elseif exp.exp_diff < 0 %}
							<span style="color: red; font-weight: bold;">{{ exp.exp_diff|number_format(0, '.', '.') }} (Lost Experience)</span>
						{% else %}
							<span style="color: #5A2800;">not gain exp (No Experience)</span>
						{% endif %}
					</td>
				</tr>
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Record of Daily Experiences', 'content': exp_hist_html} %}

		<br/>
		{% set exp_graph_html %}
		<div class="tibia-inner-frame" style="padding: 10px; background-color: {{ config.lightborder }}; box-sizing: border-box; max-width: 530px; overflow: hidden; margin: 0 auto;">
			<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
			<div style="width: 510px; max-width: 100%; height: 250px; position: relative; overflow: hidden; margin: 0 auto;">
				<canvas id="exp_chart_canvas" style="width: 100% !important; height: 250px !important;"></canvas>
			</div>
			<script type="text/javascript">
			  document.addEventListener("DOMContentLoaded", function() {
				var ctx = document.getElementById('exp_chart_canvas').getContext('2d');
				
				var labels = [
				  {% for exp in exp_history|reverse %}
				  '{{ exp.date }}',
				  {% endfor %}
				];
				
				var dataPoints = [
				  {% for exp in exp_history|reverse %}
				  {{ exp.exp_diff }},
				  {% endfor %}
				];

				Chart.register(ChartDataLabels);

				var chart = new Chart(ctx, {
				  type: 'line',
				  data: {
					labels: labels,
					datasets: [{
					  label: 'Player Experience Graphic History',
					  data: dataPoints,
					  fill: false,
					  pointBackgroundColor: function(context) {
						var value = context.dataset.data[context.dataIndex];
						return value < 0 ? 'red' : '#32CD32';
					  },
					  pointBorderColor: function(context) {
						var value = context.dataset.data[context.dataIndex];
						return value < 0 ? 'darkred' : 'darkgreen';
					  },
					  segment: {
						borderColor: function(context) {
						  return context.p1.parsed.y < 0 ? 'red' : '#32CD32';
						}
					  },
					  backgroundColor: '#32CD32',
					  borderColor: '#32CD32',
					  borderWidth: 1.5,
					  pointRadius: 4,
					  pointHoverRadius: 6
					}]
				  },
				  options: {
					responsive: false,
					maintainAspectRatio: false,
					layout: {
					  padding: { top: 30, bottom: 10, left: 10, right: 10 }
					},
					plugins: {
					  legend: { position: 'top', labels: { color: '#666', font: { size: 12, family: 'Arial' }, boxWidth: 40 } },
					  datalabels: {
						align: function(context) { return context.dataset.data[context.dataIndex] < 0 ? 'bottom' : 'top'; },
						offset: 4,
						color: function(context) { return context.dataset.data[context.dataIndex] < 0 ? 'red' : 'green'; },
						font: { weight: 'bold', size: 11 },
						formatter: function(value) { return value.toLocaleString('pt-BR'); }
					  },
					  tooltip: {
						callbacks: {
						  label: function(context) { return ' Exp: ' + context.parsed.y.toLocaleString('pt-BR'); }
						}
					  }
					},
					scales: {
					  y: { grid: { color: 'rgba(0, 0, 0, 0.05)' }, ticks: { color: '#666' } },
					  x: { grid: { color: 'rgba(0, 0, 0, 0.05)' }, ticks: { color: '#666' } }
					}
				  }
				});
			  });
			</script>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'General Experience Records Graph', 'content': exp_graph_html} %}
		<!-- EXP HISTORY_END -->
		{% endif %}

		{% if not player.isHidden() %}
		{% set rows = 0 %}
		<!-- ACCOUNT_INFORMATION -->
		<br/><br/>
		{% set acc_info_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				{% set realName = account.getRLName() %}
				{% if realName is not empty %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Real name:</td>
					<td>{{ realName }}</td>
				</tr>
				{% endif %}

				{% set group = player.getGroup() %}
				{% if group.isLoaded() and group.getId() != 1 %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Position:</td>
					<td>
						{% set gname = group.getName()|lower %}
						{% if gname == 'administrador' or gname == 'god' or gname == 'admin' %}
							<span class="admin" style="color: #00A800 !important;">Administrador</span>
						{% elseif gname == 'community manager' or gname == 'cm' %}
							<span class="communitym" style="color: #E60000 !important;">Community Manager</span>
						{% elseif gname == 'gamemaster' or gname == 'gm' %}
							<span class="gms" style="color: #0066FF !important;">Gamemaster</span>
						{% elseif gname == 'senior tutor' %}
							<span class="seniortutor" style="color: #E6A100 !important;">Senior Tutor</span>
						{% elseif gname == 'tutor' %}
							<span class="tutor" style="color: #9933FF !important;">Tutor</span>
						{% else %}
							<span style="font-weight: bold;">{{ group.getName()|capitalize }}</span>
						{% endif %}
					</td>
				</tr>
				{% endif %}

				{% set realLocation = account.getLocation() %}
				{% if realLocation is not empty %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Location:</td>
					<td>{{ realLocation }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Created:</td>
					<td>
						{{ account.getCreated()|date("j F Y, g:i a") }}
						{% if gm_ban_info is not null %}
							<span style="color: red; font-weight: bold; margin-left: 8px;">
								[Banished by GM {{ gm_ban_info.banned_by }}: {{ gm_ban_info.reason }} (Until: {{ gm_ban_info.expires_at }})]
							</span>
						{% endif %}
					</td>
				</tr>
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Account Information', 'content': acc_info_html} %}
		<!-- ACCOUNT_INFORMATION_END -->

		{{ hook('HOOK_CHARACTERS_AFTER_ACCOUNT') }}
		<!-- CHARACTERS_LIST -->
		<br/><br/>
		{% set chars_list_html %}
		<div class="tibia-inner-frame">
			<table border="0" cellspacing="1" cellpadding="4" width="100%">
				<tr bgcolor="{{ config.darkborder }}">
					<td width="62%"><b>Name</b></td>
					<td width="30%"><b>Level</b></td>
					<td width="8%"><b>Status</b></td>
					<td><b>&#160;</b></td>
				</tr>
				{% set i = 0 %}
				{% for player in account_players %}
					{% if not player.isHidden() and (config('characters')['deleted'] or not player.isDeleted()) %}
					{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td>
						<nobr>{{ i }}.&#160;{{ player.getName() }}{% if player.isDeleted() %}<span style="color: red"> [DELETED]</span>{% endif %}</nobr>
					</td>

					<td>{{ player.getLevel() }} {{ player.getVocationName() }}</td>
					<td>{% if player.isOnline() %}<b><span style="color: green">Online</span></b>{% endif %}</td>
					<td>
						<table border="0" cellspacing="0" cellpadding="0">
							<form action="{{ getLink('characters') }}" method="post">
								{{ csrf() }}
								<tr>
									<td>
										<input type="hidden" name="name" value="{{ player.getName() }}"/>
										{% set button_name = "View" %}
										{{ include('buttons.base.html.twig') }}
									</td>
								</tr>
							</form>
						</table>
					</td>
				</tr>
					{% endif %}
				{% endfor %}
			</table>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Characters', 'content': chars_list_html} %}
		<!-- CHARACTERS_LIST_END -->
		{% endif %}
		{{ hook('HOOK_CHARACTERS_AFTER_CHARACTERS') }}
		</td>
		<td>
			<img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0">
		</td>
	</tr>
</table>
<br/><br/>
{% set search_box_html %}
<div class="tibia-inner-frame" style="padding: 10px; background-color: {{ config.lightborder }};">
	{{ search_form|raw }}
</div>
{% endset %}
{% include 'tables.headline.html.twig' with {'title': 'Search Character', 'content': search_box_html} %}