			<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
			<div style="width: 510px; max-width: 100%; height: 250px; position: relative; overflow: hidden; margin: 0 auto;">
				<canvas id="exp_chart_canvas" style="width: 100% !important; height: 250px !important;"></canvas>
