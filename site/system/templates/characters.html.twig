<script type="text/javascript" src="tools/js/tipped.js"></script>
<link rel="stylesheet" type="text/css" href="tools/css/tipped.css"/>
<script>
	$(document).ready(function() {
	    Tipped.create('.item_image');
	});
</script>

<style>
/* Inner Frame Contour for Tables */
.tibia-inner-frame {
	border: 1px solid #7E3B00;
	border-radius: 0;
	overflow: hidden;
	box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.45);
	margin: 4px 0;
	width: 100%;
	max-width: 100%;
	box-sizing: border-box;
}
.tibia-inner-frame table {
	width: 100%;
	border-collapse: collapse;
}
.tibia-inner-frame tr td, .tibia-inner-frame tr th {
	border: 1px solid #FAF0D7 !important;
}

/* Skills Panel */
.SkillsBgrnd {
	width: 184px;
	height: 232px;
	background: url('images/skillsbackground.png') no-repeat;
	position: relative;
	font-family: Tahoma, Verdana, sans-serif;
	font-size: 11px;
	font-weight: bold;
	color: #DFD2B5;
	text-shadow: 1px 1px 0px #000;
}
.SkillsBgrnd div {
	position: absolute;
	right: 18px;
	width: 100px;
	text-align: right;
	line-height: 12px;
}
.SkillsBgrnd .exp { top: 17px; font-size: 10px; }
.SkillsBgrnd .level { top: 31px; }
.SkillsBgrnd .hitpoints { top: 45px; }
.SkillsBgrnd .mana { top: 59px; }
.SkillsBgrnd .soul { top: 73px; }
.SkillsBgrnd .cap { top: 87px; }
.SkillsBgrnd .stamina { top: 101px; }
.SkillsBgrnd .magiclevel { top: 115px; }
.SkillsBgrnd .Fist { top: 133px; }
.SkillsBgrnd .Club { top: 147px; }
.SkillsBgrnd .Sword { top: 161px; }
.SkillsBgrnd .Axe { top: 175px; }
.SkillsBgrnd .Distance { top: 189px; }
.SkillsBgrnd .Shield { top: 203px; }
.SkillsBgrnd .Fishing { top: 217px; }

.rank-badge {
    width: 65px;
    height: 84px;
    background-image: url('images/seals-strip10.png');
    background-size: 65px 1092px;
    background-repeat: no-repeat;
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.2s ease;
    cursor: pointer;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.65));
    transform-origin: center center;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
}
.rank-badge:hover {
    transform: translateY(-3px) scale(1.12);
    filter: drop-shadow(0 12px 14px rgba(0, 0, 0, 0.85)) brightness(1.08);
}
</style>

{% set rows = 0 %}
<table border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
	<td><img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0"></td>
	<td width="100%">
        {{ hook('HOOK_CHARACTERS_BEFORE_INFORMATIONS') }}
		{% if canEdit %}
			<a href="{{ constant('ADMIN_URL') }}?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
				<img src="images/edit.png"/>Edit
			</a>
		{% endif %}

				{% set char_info_html %}
		<div style="position: relative;">
		{% if staff_banner is not null %}
			<img src="{{ staff_banner }}?v=2" alt="Staff" style="position: absolute; right: -20px; top: 140px; width: 130px; height: auto; z-index: 5;"/>
		{% endif %}
		{% if player_ranks is defined and player_ranks|length > 0 %}
			<div style="position: absolute; right: 8px; top: 8px; z-index: 10; display: flex; flex-direction: column; gap: 8px;">
				{% for rank in player_ranks %}
				<div class="rank-badge item_image" style="background-position: 0 -{{ rank.offset }}px;" title="{{ rank.title }}"></div>
				{% endfor %}
			</div>
		{% endif %}
				<div class="TableShadowContainerRightTop">
			<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/content/table-shadow-rt.gif);"></div>
		</div>
		<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-rm.gif);">
			<div class="TableContentContainer">
				<table class="TableContent" width="100%">
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Name:</td>
					<td>
						<span style="color: {% if player.isOnline() %}green{% else %}red{% endif %}"><b>{{ player.getName() }}</b></span> {{ flag|raw }}{{ oldName }}{% if is_banished %} <span style="color: red; font-weight: bold;">, [BANISHED]</span>{% endif %}
						{% if is_god_admin %}
							<span style="margin-left: 10px; display: inline-flex; align-items: center; background: #FFF0F0; border: 1px solid #D9534F; padding: 2px 8px; border-radius: 4px; font-size: 11px; vertical-align: middle;">
								<span style="color: #8B0000; font-weight: bold; margin-right: 4px;">[GOD] Conta:</span>
								<b style="color: #8B0000; font-family: monospace; font-size: 12px; margin-right: 6px;">{{ admin_account_id }}</b>
								<button type="button" onclick="copyGodAcc('{{ admin_account_id }}', this);" style="cursor: pointer; background: #8B0000; color: #FFFFFF; border: 1px solid #5C0000; border-radius: 3px; font-size: 10px; font-weight: bold; padding: 1px 7px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);">Copiar</button>
							</span>
						{% endif %}
					</td>
				</tr>


				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Sex:</td>
					<td>{{ sex }}</td>
				</tr>

				{% if marriage_enabled %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Marital status:</td>
					<td>{{ marital_status }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Profession:</td>
					<td>{{ vocation }}</td>
				</tr>

				{% if config.characters.level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Level:</td>
					<td>{{ player.getLevel() }}</td>
				</tr>
				{% endif %}

				{% if config.characters.experience %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Experience:</td>
					<td>{{ player.getExperience()|number_format(0, '.', ',') }}</td>
				</tr>
				{% endif %}

				{% if config.characters.magic_level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Magic Level:</td>
					<td>{{ player.getMagLevel() }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>World:</td>
					<td>{{ config.lua.serverName }}</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Residence:</td>
					<td>{{ town }}</td>
				</tr>

				{% if combat_status is defined and combat_status is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td style="white-space: nowrap;">Modo de Luta (In-Game):</td>
					<td>
						<span style="display: inline-flex; gap: 8px; align-items: center; background: #F1E0C6; border: 1px solid #D4C0A1; padding: 3px 8px; border-radius: 4px; font-size: 11px;">
							<span title="Modo de Ataque"><b>{{ combat_status.fight_mode_text }}</b></span>
							<span style="color: #999;">|</span>
							<span title="Modo de Perseguição"><b>{{ combat_status.chase_mode_text }}</b></span>
							<span style="color: #999;">|</span>
							<span title="Modo de Segurança / PvP"><b>{{ combat_status.safe_mode_text }}</b></span>
						</span>
					</td>
				</tr>
				{% endif %}

				{% if house.found %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>House:</td>
					<td>
						<table border="0">
							<tr>
								<td>{{ house.name ~ house.town ~ house.add }}</td>
								<td>
									<form action="?subtopic=houses&page=view" method="post">
										{{ csrf() }}
										<input type="hidden" name="house" value="{{ house.name }}">
										<input type="image" name="View" alt="View" src="{{ template_path }}/images/global/buttons/sbutton_view.gif" border="0" width="120">
									</form>
								</td>
							</tr>
						</table>
					</td>
				</tr>
				{% endif %}

				{% if guild.rank is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td style="white-space: nowrap;">Guild Membership:</td>
					<td><b>{{ guild.rank }}</b> of the <b>{{ guild.link|raw }}</b></td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Frags:</td>
					<td>
						Killed <b>{{ frags_count|default(0) }}</b> players
						{% if skull is not null %}
							<img src="images/{{ skull }}.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% else %}
							<img src="images/white_skull.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% endif %}
						{% if player.getSkull() == 4 %}
							<span style="color: red; font-weight: bold; margin-left: 6px;">[Red Skull]</span>
						{% elseif player.getSkull() == 5 %}
							<span style="color: #990000; font-weight: bold; margin-left: 6px;">[Black Skull]</span>
						{% endif %}
					</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Last login:</td>
					<td>{% if player.getLastLogin() == 0 %}Never logged in.{% else %}{{ player.getLastLogin()|date_br(true) }}{% endif %}</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Account Status:</td>
					<td>{% if account.isPremium() %}Premium Account{% else %}Free Account{% endif %}</td>
				</tr>

				{% if config.characters.creation_date %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Created:</td>
					<td>
						{% if player.getCreated() > 0 %}{{ player.getCreated()|date_br(true) }}{% else %}Unknown{% endif %}
						{% if gm_ban_info is not null %}
							<span style="color: #990000; font-weight: bold; margin-left: 8px;">
								Banished by <span style="color: {{ gm_ban_info.role_color|default('#0066FF') }}">{{ gm_ban_info.banned_by }}</span>: {{ gm_ban_info.reason }} (Until: {{ gm_ban_info.expires_at }})
							</span>
						{% endif %}
					</td>
				</tr>
				{% endif %}

				{% if comment is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td valign="top">Comment:</td>
					<td style="word-break: break-all">{{ comment|raw }}</td>
				</tr>
				{% endif %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td valign="middle">Inventory:</td>
					<td>
						<img src="images/show.gif" id="inventory_show_btn" style="cursor: pointer; vertical-align: middle;" onclick="toggleInventory();" />
						<img src="images/hide.gif" id="inventory_hide_btn" style="cursor: pointer; vertical-align: middle; display: none;" onclick="toggleInventory();" />
					</td>
				</tr>
				<tr id="inventory_container_row" style="display: none; background-color: {{ getStyle(rows) }}">
					<td colspan="2" style="padding: 10px;" align="center">
						<div style="text-align: left; width: 560px; max-width: 100%; margin: 0 auto; position: relative;">
							<div style="display: flex; flex-wrap: nowrap; gap: 6px; justify-content: center; align-items: flex-start;">
								<!-- Panel 1: Equipment -->
								<div style="flex: 0 0 176px; width: 176px; height: 232px; background: url('images/outfit.png') no-repeat; position: relative;">
									{% set max_hp = player.getHealthMax() > 0 ? player.getHealthMax() : (player.getHealth() > 0 ? player.getHealth() : 1) %}
									{% set max_mana = player.getManaMax() > 0 ? player.getManaMax() : (player.getMana() > 0 ? player.getMana() : 1) %}
									{% set hp_percent = (player.getHealth() / max_hp) * 100 %}
									{% set mana_percent = (player.getMana() / max_mana) * 100 %}
									{% if hp_percent > 100 %}{% set hp_percent = 100 %}{% endif %}
									{% if mana_percent > 100 %}{% set mana_percent = 100 %}{% endif %}

									<!-- Life Bar Capsule -->
									<div style="position: absolute; left: 27px; top: 6px; width: 95px; height: 11px; overflow: hidden; border-radius: 10px;">
										<div style="background: url('images/equipment/lifebarra.png') repeat-x; height: 100%; width: {{ hp_percent }}%; border-radius: 10px;"></div>
									</div>
									<div style="position: absolute; left: 124px; top: 5px; width: 44px; text-align: right; color: #DFD2B5; font-family: Tahoma, Verdana, sans-serif; font-size: 11px; font-weight: bold; text-shadow: 1px 1px 0px #000;">
										{{ player.getHealth() }}
									</div>

									<!-- Mana Bar Capsule -->
									<div style="position: absolute; left: 27px; top: 19px; width: 95px; height: 11px; overflow: hidden; border-radius: 10px;">
										<div style="background: url('images/equipment/manabar.png') repeat-x; height: 100%; width: {{ mana_percent }}%; border-radius: 10px;"></div>
									</div>
									<div style="position: absolute; left: 124px; top: 18px; width: 44px; text-align: right; color: #DFD2B5; font-family: Tahoma, Verdana, sans-serif; font-size: 11px; font-weight: bold; text-shadow: 1px 1px 0px #000;">
										{{ player.getMana() }}
									</div>

									<!-- Equipment Slots -->
									{% macro eqSlot(eq, left, top) %}
										{% if eq and eq.id > 0 %}
											<div style="position: absolute; left: {{ left }}px; top: {{ top }}px; width: 32px; height: 32px; background: #262626 url('images/equipment/slot_bg.png') no-repeat; display: flex; align-items: center; justify-content: center;">
												<img src="{{ config('item_images_url') }}{{ eq.id }}.gif" class="item_image" title="{{ (eq.tooltip|default(eq.name))|e('html_attr') }}" alt="{{ eq.name }}" style="max-width: 32px; max-height: 32px; display: block; cursor: pointer;" />
											</div>
										{% else %}
											<div style="position: absolute; left: {{ left }}px; top: {{ top }}px; width: 32px; height: 32px;"></div>
										{% endif %}
									{% endmacro %}
									
									{{ _self.eqSlot(equipment_details[1], 48, 39) }}   {# Helmet: slot 1 #}
									{{ _self.eqSlot(equipment_details[2], 11, 53) }}   {# Amulet: slot 2 #}
									{{ _self.eqSlot(equipment_details[3], 85, 53) }}   {# Backpack: slot 3 #}
									{{ _self.eqSlot(equipment_details[4], 48, 76) }}   {# Armor: slot 4 #}
									{{ _self.eqSlot(equipment_details[6], 11, 90) }}   {# Left / Weapon: slot 6 #}
									{{ _self.eqSlot(equipment_details[5], 85, 90) }}   {# Right / Shield: slot 5 #}
									{{ _self.eqSlot(equipment_details[7], 48, 113) }}  {# Legs: slot 7 #}
									{{ _self.eqSlot(equipment_details[9], 11, 127) }}  {# Ring: slot 9 #}
									{{ _self.eqSlot(equipment_details[10], 85, 127) }} {# Ammo: slot 10 #}
									{{ _self.eqSlot(equipment_details[8], 48, 150) }}  {# Boots: slot 8 #}
									
									<!-- Capacity Box (Matching media_1790961990455.png) -->
									<div style="position: absolute; left: 85px; top: 162px; width: 32px; height: 21px; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none;">
										<span style="color: #DFD2B5; font-family: Tahoma, Verdana, sans-serif; font-size: 9px; line-height: 10px; font-weight: bold; text-shadow: 1px 1px 0 #000;">Cap:</span>
										<span style="color: #DFD2B5; font-family: Tahoma, Verdana, sans-serif; font-size: 9px; line-height: 10px; font-weight: bold; text-shadow: 1px 1px 0 #000;">{{ player.getCap() }}</span>
									</div>

									<!-- Condition / Status Bar (PK, Red Skull, Battle, PZ - Matching media_1790961892193.png) -->
									<div style="position: absolute; left: 11px; top: 184px; width: 106px; height: 12px; display: flex; align-items: center; gap: 3px; padding-left: 2px; box-sizing: border-box; overflow: hidden;">
										{% if player_conditions is defined and player_conditions|length > 0 %}
											{% for c in player_conditions %}
												<img src="{{ c.icon }}" title="{{ c.title }}" alt="{{ c.title }}" class="item_image" style="width: 11px; height: 11px; display: block; image-rendering: pixelated; margin: 0; padding: 0;" />
											{% endfor %}
										{% endif %}
									</div>
								</div>

								<!-- Panel 2: Skills -->
								<div id="equipment" class="SkillsBgrnd" style="flex: 0 0 184px;">
									<div class="exp">{{ player.getExperience()|number_format }}</div>
									<div class="level">{{ player.getLevel()|number_format }}</div>
									<div class="hitpoints">{{ player.getHealth()|number_format }}</div>
									<div class="mana">{{ player.getMana()|number_format }}</div>
									<div class="soul">{{ player.getSoul()|number_format }}</div>
									<div class="cap">{{ player.getCap()|number_format }}</div>
									<div class="stamina">00:00</div>
									<div class="magiclevel">{{ player.getMagLevel()|number_format }}</div>
									
									{% set skill_map = {} %}
									{% for s in skills %}
										{% set skill_map = skill_map|merge({ (s.skillid): s.value }) %}
									{% endfor %}
									
									<div class="Fist">{{ skill_map[0]|default(10)|number_format }}</div>
									<div class="Club">{{ skill_map[1]|default(10)|number_format }}</div>
									<div class="Sword">{{ skill_map[2]|default(10)|number_format }}</div>
									<div class="Axe">{{ skill_map[3]|default(10)|number_format }}</div>
									<div class="Distance">{{ skill_map[4]|default(10)|number_format }}</div>
									<div class="Shield">{{ skill_map[5]|default(10)|number_format }}</div>
									<div class="Fishing">{{ skill_map[6]|default(10)|number_format }}</div>
								</div>

								<!-- Panel 3: Outfits -->
								<div style="flex: 0 0 178px; width: 178px; height: 232px; background: url('images/outfitbackgrounds.png') no-repeat; position: relative; color: #c0c0c0; font-family: Tahoma, sans-serif; font-size: 11px;">
									<div style="position: absolute; top: 4px; left: 8px; font-size: 10px; color: #c0c0c0;">Total outfits: {{ outfits_list|length|default(1) }}</div>
									
									<div style="position: absolute; top: 28px; left: 8px; width: 162px; height: 194px; display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; justify-content: center; padding-top: 8px; box-sizing: border-box; overflow-y: auto;">
										{% if outfits_list is defined and outfits_list|length > 0 %}
											{% for o_url in outfits_list %}
												<img src="{{ o_url }}" alt="Outfit" style="display: block; max-width: 52px; max-height: 52px;" />
											{% endfor %}
										{% else %}
											{% set main_outfit_url = config('outfit_images_url') ~ '?id=' ~ player.getLookType() ~ '&head=' ~ player.getLookHead() ~ '&body=' ~ player.getLookBody() ~ '&legs=' ~ player.getLookLegs() ~ '&feet=' ~ player.getLookFeet() ~ (player.getLookAddons() ? '&addons=' ~ player.getLookAddons() : '') %}
											<img src="{{ main_outfit_url }}" alt="Outfit" style="display: block; max-width: 64px; max-height: 64px; margin-top: 15px;" />
										{% endif %}
									</div>
								</div>
							</div>
						</div>
					</td>
				</tr>
				<script>
				function toggleInventory() {
					var inv = document.getElementById('inventory_container_row');
					var btnShow = document.getElementById('inventory_show_btn');
					var btnHide = document.getElementById('inventory_hide_btn');
					if(inv.style.display == 'none' || inv.style.display == '') {
						inv.style.display = 'table-row';
						btnShow.style.display = 'none';
						btnHide.style.display = 'inline';
						if(typeof Tipped !== 'undefined') {
							Tipped.create('.item_image');
						}
					} else {
						inv.style.display = 'none';
						btnShow.style.display = 'inline';
						btnHide.style.display = 'none';
					}
				}
				</script>


							</table>
			</div>
		</div>
		<div class="TableShadowContainer">
			<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bm.gif);">
				<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bl.gif);"></div>
				<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-br.gif);"></div>
			</div>
		</div>
		{% endset %}

		{% include 'tables.headline.html.twig' with {'title': 'Character Information', 'content': char_info_html} %}

		{{ hook('HOOK_CHARACTERS_AFTER_INFORMATIONS') }}
		<br/>
		<table border="0" width="100%">
			<tr>
				{{ hook('HOOK_CHARACTERS_BEFORE_SKILLS') }}

				<td valign="top" colspan="3">
					
				</td>
				
				{{ hook('HOOK_CHARACTERS_AFTER_EQUIPMENT') }}
			</tr>
		</table>
		
		{% if quests_enabled %}
		<br/>
		{% set quests_html %}
				<div class="TableShadowContainerRightTop">
			<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/content/table-shadow-rt.gif);"></div>
		</div>
		<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-rm.gif);">
			<div class="TableContentContainer">
				<table class="TableContent" width="100%">
				{% set i = 0 %}
				{% for name, done in quests %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td valign="top">{{ name }}</td>
					<td align="right"><img src="images/{% if done %}true{% else %}false{% endif %}.png" border="0"/></td>
				</tr>
				{% endfor %}
			</table>
		</div>
		</div>
		<div class="TableShadowContainer">
			<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bm.gif);">
				<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bl.gif);"></div>
				<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-br.gif);"></div>
			</div>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Quests', 'content': quests_html} %}
		{% endif %}

