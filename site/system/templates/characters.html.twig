<script type="text/javascript" src="tools/js/tipped.js"></script>
<link rel="stylesheet" type="text/css" href="tools/css/tipped.css"/>
<script>
	$(document).ready(function() {
	    Tipped.create('.item_image');
	});
</script>
{% set rows = 0 %}
<table border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
	<td><img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0"></td>
	<td>
        {{ hook('HOOK_CHARACTERS_BEFORE_INFORMATIONS') }}
		{% if canEdit %}
			<a href="{{ constant('ADMIN_URL') }}?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
				<img src="images/edit.png"/>Edit
			</a>
		{% endif %}
		<table border="0" cellspacing="1" cellpadding="4" width="100%">


			<tr bgcolor="{{ config.vdarkborder }}">
				<td colspan="2" class="white"><b>Character Information</b></td>
			</tr>

			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td width="20%">Name:</td>
				<td style="position: relative;">
					<span style="color: {% if player.isOnline() %}green{% else %}red{% endif %}"><b>{{ player.getName() }}</b></span> {{ flag|raw }}{{ oldName }}
					{% if player.getName()|lower == 'nosleiragod' %}
					<style>
					.admin-ribbon-container {
					    position: absolute;
					    right: -5px;
					    top: 50%;
					    transform: translateY(-50%);
					    z-index: 100;
					}
					.admin-ribbon {
					    position: relative;
					    height: 28px;
					    line-height: 26px;
					    box-sizing: border-box;
					    background: linear-gradient(to bottom, #A11818 0%, #680000 100%);
					    border: 1px solid #D4AF37; 
					    border-right: none;
					    color: #FFF3A0; 
					    padding: 0 15px 0 35px;
					    font-family: 'Book Antiqua', 'Times New Roman', serif;
					    font-size: 14px;
					    font-weight: bold;
					    text-shadow: 1px 1px 2px black;
					    box-shadow: 2px 3px 5px rgba(0,0,0,0.5);
					}
					.admin-ribbon::before {
					    content: '';
					    position: absolute;
					    left: -14px;
					    top: -1px;
					    border-top: 14px solid transparent;
					    border-bottom: 14px solid transparent;
					    border-right: 14px solid #D4AF37; 
					}
					.admin-ribbon::after {
					    content: '';
					    position: absolute;
					    left: -12px;
					    top: 0px;
					    border-top: 13px solid transparent;
					    border-bottom: 13px solid transparent;
					    border-right: 13px solid #850B0B; 
					}
					.admin-ribbon .fold {
					    position: absolute;
					    right: 0px;
					    bottom: -6px;
					    border-top: 5px solid #330000;
					    border-right: 5px solid transparent;
					}
					.admin-ribbon .icon {
					    position: absolute;
					    left: 8px;
					    top: 50%;
					    transform: translateY(-50%);
					    font-size: 16px;
					    filter: drop-shadow(1px 1px 1px black);
					}
					</style>
					<div class="admin-ribbon-container" title="Administrador">
					    <div class="admin-ribbon">
					        <span class="icon">🛡️</span>
					        Administrador
					        <div class="fold"></div>
					    </div>
					</div>
					{% endif %}
				</td>
			</tr>

			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Sex:</td>
				<td>{{ sex }}</td>
			</tr>

			{% if marriage_enabled %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Marital status:</td>
				<td>{{ marital_status }}</td>
			</tr>
			{% endif %}

			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Profession:</td>
				<td>{{ vocation }}</td>
			</tr>

			{% if config.characters.level %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Level:</td>
				<td>{{ player.getLevel() }}</td>
			</tr>
			{% endif %}

			{% if config.characters.experience %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Experience:</td>
				<td>{{ player.getExperience() }}</td>
			</tr>
			{% endif %}

			{% if config.characters.magic_level %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Magic Level:</td>
				<td>{{ player.getMagLevel() }}</td>
			</tr>
			{% endif %}

			{% if frags_enabled %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Frags:</td>
				<td>{{ frags_count }}</td>
			</tr>
			{% endif %}

			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Residence:</td>
				<td>{{ town }}</td>
			</tr>



			{% if house.found %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>House:</td>
				<td>
					<table border="0">
						<tr>
							<td>{{ house.name ~ house.town ~ house.add }}</td>
							<td>
								<form action="?subtopic=houses&page=view" method="post">
									{{ csrf() }}
									<input type="hidden" name="house" value="{{ house.name }}">
									<input type="image" name="View" alt="View" src="{{ template_path }}/images/global/buttons/sbutton_view.gif" border="0" width="120">
								</form>
							</td>
						</tr>
					</table>
				</td>
			</tr>
			{% endif %}

			{% if guild.rank is not null %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Guild membership:</td>
				<td>{{ guild.rank }} of the {{ guild.link|raw }}</td>
			</tr>
			{% endif %}

			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Last login:</td>
				<td>{% if player.getLastLogin() == 0 %}Never logged in.{% else %}{{ player.getLastLogin()|date("M d Y, H:i:s") }} CEST{% endif %}</td>
			</tr>

			{% if config.characters.creation_date %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Created:</td>
				<td>{{ player.getCreated()|date("M d Y, H:i:s") }} CEST</td>
			</tr>
			{% endif %}

			{% if comment is not null %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td valign="top">Comment:</td>
				<td style="word-break: break-all">{{ comment|raw }}</td>
			</tr>
			{% endif %}

			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Account Status:</td>
				<td>{% if account.isPremium() %}Premium Account{% else %}Free Account{% endif %}</td>
			</tr>
		</table>
		{{ hook('HOOK_CHARACTERS_AFTER_INFORMATIONS') }}
		<br/>
		<table border="0" width="100%">
			<tr>
				{{ hook('HOOK_CHARACTERS_BEFORE_SKILLS') }}

				<td valign="top" colspan="3">
					<!-- TIBIA UI START -->
					<style>
					.tibia-ui {
						display: flex;
						flex-wrap: wrap;
						gap: 15px;
						padding: 15px;
						background: #3A3A3A;
						border: 1px solid #111;
						font-family: Tahoma, sans-serif;
						font-size: 11px;
						color: #C0C0C0;
						justify-content: center;
					}
					.tibia-window {
						background: #363636;
						border-top: 1px solid #5A5A5A;
						border-left: 1px solid #5A5A5A;
						border-bottom: 1px solid #111;
						border-right: 1px solid #111;
						width: 175px;
						box-shadow: 1px 1px 2px rgba(0,0,0,0.5);
					}
					.tibia-window-header {
						background: #363636;
						border-bottom: 1px solid #111;
						padding: 2px 4px;
						display: flex;
						justify-content: space-between;
						align-items: center;
						color: #C0C0C0;
						cursor: pointer;
					}
					.tibia-window-content {
						padding: 5px;
						background: #3A3A3A;
						border-top: 1px solid #5A5A5A;
					}
					/* Health/Mana Bars */
					.tibia-bar-container {
						margin-bottom: 4px;
						background: #000;
						height: 12px;
						border: 1px solid #111;
						position: relative;
					}
					.tibia-bar-hp {
						background: #D82828;
						height: 100%;
					}
					.tibia-bar-mana {
						background: #4848D8;
						height: 100%;
					}
					.tibia-bar-text {
						position: absolute;
						top: -1px;
						right: 3px;
						font-size: 10px;
						color: #FFF;
						text-shadow: 1px 1px 0 #000;
					}
					/* Inventory Slots */
					.tibia-eq-grid {
						display: grid;
						grid-template-columns: 34px 34px 34px;
						grid-gap: 4px;
						justify-content: center;
						margin-bottom: 5px;
					}
					.tibia-slot {
						width: 34px;
						height: 34px;
						background: #2B2B2B;
						border-top: 1px solid #000;
						border-left: 1px solid #000;
						border-bottom: 1px solid #5A5A5A;
						border-right: 1px solid #5A5A5A;
						display: flex;
						align-items: center;
						justify-content: center;
					}
					/* Equipment positioning */
					.slot-neck { grid-column: 1; grid-row: 1; }
					.slot-head { grid-column: 2; grid-row: 1; }
					.slot-back { grid-column: 3; grid-row: 1; }
					.slot-left { grid-column: 1; grid-row: 2; }
					.slot-armor { grid-column: 2; grid-row: 2; }
					.slot-right { grid-column: 3; grid-row: 2; }
					.slot-ring { grid-column: 1; grid-row: 3; }
					.slot-legs { grid-column: 2; grid-row: 3; }
					.slot-ammo { grid-column: 3; grid-row: 3; }
					.slot-soul { grid-column: 1; grid-row: 4; text-align:center; padding-top:4px; font-size:10px; background: transparent; border: none; }
					.slot-boots { grid-column: 2; grid-row: 4; }
					.slot-cap { grid-column: 3; grid-row: 4; text-align:center; padding-top:4px; font-size:10px; background: transparent; border: none;}
					
					/* Skills */
					.tibia-skill-row {
						display: flex;
						justify-content: space-between;
						margin-bottom: 2px;
					}
					.tibia-skill-name { color: #C0C0C0; }
					.tibia-skill-val { color: #C0C0C0; text-align: right; }
					.tibia-skill-sep { border-bottom: 1px solid #111; margin: 4px 0; border-top: 1px solid #5A5A5A; }
					
					/* Outfits */
					.tibia-outfit-box {
						width: 128px;
						height: 128px;
						margin: 0 auto;
						display: flex;
						align-items: center;
						justify-content: center;
						position: relative;
					}
					.tibia-outfit-box img {
						width: 128px;
						height: 128px;
						margin-left: -32px;
						margin-top: -32px;
					}
					</style>

					<script>
					function toggleWindow(id) {
						var el = document.getElementById(id);
						if(el.style.display == 'none') el.style.display = 'block';
						else el.style.display = 'none';
					}
					</script>

					<div style="margin-bottom: 5px;">
						<button style="background: #2b2b2b; color: #fff; border: 1px solid #111; border-top: 1px solid #5a5a5a; border-left: 1px solid #5a5a5a; padding: 2px 5px; cursor: pointer;" onclick="toggleWindow('win-inventory')">Hide/Show Inventory</button>
					</div>

					<div class="tibia-ui">
						<!-- Inventory -->
						<div class="tibia-window" id="win-inventory" style="display:none;">
							<div class="tibia-window-header" onclick="toggleWindow('win-inventory')">
								<div><img src="images/general/blank.gif" width="10" height="10" style="background:#555; border:1px solid #111;"/> Inventory</div>
								<div>x</div>
							</div>
							<div class="tibia-window-content">
								<div class="tibia-bar-container">
									{% set hp_percent = (player.getHealthMax() > 0) ? (player.getHealth() / player.getHealthMax()) * 100 : 0 %}
									<div class="tibia-bar-hp" style="width: {{ hp_percent }}%;"></div>
									<div class="tibia-bar-text">{{ player.getHealth() }}</div>
								</div>
								<div class="tibia-bar-container">
									{% set mana_percent = (player.getManaMax() > 0) ? (player.getMana() / player.getManaMax()) * 100 : 0 %}
									<div class="tibia-bar-mana" style="width: {{ mana_percent }}%;"></div>
									<div class="tibia-bar-text">{{ player.getMana() }}</div>
								</div>
								
								<div class="tibia-eq-grid">
									<div class="tibia-slot slot-neck">{{ equipment[2]|raw }}</div>
									<div class="tibia-slot slot-head">{{ equipment[1]|raw }}</div>
									<div class="tibia-slot slot-back">{{ equipment[3]|raw }}</div>
									<div class="tibia-slot slot-left">{{ equipment[6]|raw }}</div>
									<div class="tibia-slot slot-armor">{{ equipment[4]|raw }}</div>
									<div class="tibia-slot slot-right">{{ equipment[5]|raw }}</div>
									<div class="tibia-slot slot-ring">{{ equipment[9]|raw }}</div>
									<div class="tibia-slot slot-legs">{{ equipment[7]|raw }}</div>
									<div class="tibia-slot slot-ammo">{{ equipment[10]|raw }}</div>
									<div class="tibia-slot slot-soul">{% if skull is not null %}<img src="images/{{ skull }}.gif">{% endif %}</div>
									<div class="tibia-slot slot-boots">{{ equipment[8]|raw }}</div>
									<div class="tibia-slot slot-cap">Cap:<br/>{{ player.getCapacity() }}</div>
								</div>
							</div>
						</div>

						<!-- Skills -->
						<div class="tibia-window">
							<div class="tibia-window-header" onclick="toggleWindow('win-skills')">
								<div><img src="images/general/blank.gif" width="10" height="10" style="background:#555; border:1px solid #111;"/> Skills</div>
								<div>_</div>
							</div>
							<div class="tibia-window-content" id="win-skills">
								<div class="tibia-skill-row"><span class="tibia-skill-name">Experience</span><span class="tibia-skill-val">{{ player.getExperience() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Level</span><span class="tibia-skill-val">{{ player.getLevel() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Hit Points</span><span class="tibia-skill-val">{{ player.getHealth() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Mana</span><span class="tibia-skill-val">{{ player.getMana() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Capacity</span><span class="tibia-skill-val">{{ player.getCapacity() }}</span></div>
								<div class="tibia-skill-row"><span class="tibia-skill-name">Magic Level</span><span class="tibia-skill-val">{{ player.getMagLevel() }}</span></div>
								<div class="tibia-skill-sep"></div>
								{% for skill in skills %}
								<div class="tibia-skill-row"><span class="tibia-skill-name">{{ skill.name }}</span><span class="tibia-skill-val">{{ skill.value }}</span></div>
								{% endfor %}
							</div>
						</div>

						<!-- Outfits -->
						<div class="tibia-window">
							<div class="tibia-window-header" onclick="toggleWindow('win-outfits')">
								<div><img src="images/general/blank.gif" width="10" height="10" style="background:#555; border:1px solid #111;"/> Outfits</div>
								<div>_</div>
							</div>
							<div class="tibia-window-content" id="win-outfits">
								<div class="tibia-outfit-box">
									{% if config.characters.outfit %}
									<img src="{{ outfit }}" alt="player outfit"/>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
					<!-- TIBIA UI END -->
				</td>
				
				{{ hook('HOOK_CHARACTERS_AFTER_EQUIPMENT') }}
			</tr>
		</table>
		
		{% if quests_enabled %}
		<br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%">
			<tr bgcolor="{{ config.vdarkborder }}">
				<td colspan="2" class="white"><b>Quests</b></td>
			</tr>
			{% set i = 0 %}
			{% for name, done in quests %}
			{% set i = i + 1 %}
			<tr bgcolor="{{ getStyle(i) }}">
				<td valign="top">{{ name }}</TD>
				<td><img src="images/{% if done %}true{% else %}false{% endif %}.png" border="0"/></td>
			</tr>
			{% endfor %}
		</table>
		{% endif %}

		{{ hook('HOOK_CHARACTERS_BEFORE_DEATHS') }}

		{% if deaths|length > 0 %}
		<!-- DEATHS -->
		<br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%">
			<tr bgcolor="{{ config.vdarkborder }}">
				<td colspan="2" class="white"><b>Character Deaths</b></td>
			</tr>
			{% set i = 0 %}
			{% for death in deaths %}
			<tr bgcolor="{{ getStyle(i) }}">
				<td width="20%" align="center">{{ death.time|date("j M Y, H:i") }}</td>
				<td>{{ death.description|raw }}</td>
			</tr>

			{% set i = i + 1 %}
			{% endfor %}
		</table>
		<!-- DEATHS_END -->
		{% endif %}
		{% if frags|length > 0 %}
		<!-- FRAGS -->
		<br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%">
			<tr bgcolor="{{ config.vdarkborder }}">
				<td colspan="2" class="white"><b>Victims</b></td>
			</tr>
			{% set i = 0 %}
			{% for frag in frags %}
			<tr bgcolor="{{ getStyle(i) }}">
				<td width="20%" align="center">{{ frag.time|date("j M Y, H:i") }}</td>
				<td>{{ frag.description|raw }} ({% if frag.unjustified %}<span style="color: red; font-size: 10px">Unjustified</span>{% else %}<span style="color: green; font-size: 10px">Justified</span>{% endif %})</td>
			</tr>
			{% set i = i + 1 %}
			{% endfor %}
		</table>
		<!-- FRAGS_END -->
		{% endif %}

		{% if exp_history %}
		<!-- EXP HISTORY -->
		<br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%">
			<tr bgcolor="{{ config.vdarkborder }}">
				<td colspan="2" class="white"><b>Record of Daily Experiences</b></td>
			</tr>
			{% set i = 0 %}
			{% for exp in exp_history %}
			{% set i = i + 1 %}
			<tr bgcolor="{{ getStyle(i) }}">
				<td width="20%" align="center"><b>{% if exp.date == 'Today' %}<span style="color: #FF6600">EXP Today</span>{% else %}{{ exp.date }}{% endif %}</b></td>
				<td>
					{% if exp.exp_diff > 0 %}
						<span style="color: green">+{{ exp.exp_diff|number_format(0, '.', '.') }} Experience</span>
					{% elseif exp.exp_diff < 0 %}
						<span style="color: red">{{ exp.exp_diff|number_format(0, '.', '.') }} Experience</span>
					{% else %}
						not gain exp (No Experience)
					{% endif %}
				</td>
			</tr>
			{% endfor %}
		</table>
		<br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%">
			<tr bgcolor="{{ config.vdarkborder }}">
				<td class="white"><b>General Experience Records Graph</b></td>
			</tr>
			<tr bgcolor="{{ config.lightborder }}">
				<td align="center">
					<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
					<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
					<div style="width: 95%; height: 250px; position: relative;">
						<canvas id="exp_chart_canvas"></canvas>
					</div>
					<script type="text/javascript">
					  document.addEventListener("DOMContentLoaded", function() {
						var ctx = document.getElementById('exp_chart_canvas').getContext('2d');
						
						var labels = [
						  {% for exp in exp_history|reverse %}
						  '{{ exp.date }}',
						  {% endfor %}
						];
						
						var dataPoints = [
						  {% for exp in exp_history|reverse %}
						  {{ exp.exp_diff }},
						  {% endfor %}
						];

						Chart.register(ChartDataLabels);

						var chart = new Chart(ctx, {
						  type: 'line',
						  data: {
							labels: labels,
							datasets: [{
							  label: 'Player Experience Graphic History',
							  data: dataPoints,
							  fill: false,
							  pointBackgroundColor: function(context) {
								var value = context.dataset.data[context.dataIndex];
								return value < 0 ? 'red' : '#32CD32';
							  },
							  pointBorderColor: function(context) {
								var value = context.dataset.data[context.dataIndex];
								return value < 0 ? 'darkred' : 'darkgreen';
							  },
							  segment: {
								borderColor: function(context) {
								  return context.p1.parsed.y < 0 ? 'red' : '#32CD32';
								}
							  },
							  backgroundColor: '#32CD32',
							  borderColor: '#32CD32',
							  borderWidth: 1.5,
							  pointRadius: 4,
							  pointHoverRadius: 6
							}]
						  },
						  options: {
							responsive: true,
							maintainAspectRatio: false,
							layout: {
							  padding: {
								top: 30,
								bottom: 10,
								left: 10,
								right: 10
							  }
							},
							plugins: {
							  legend: {
								position: 'top',
								labels: {
								  color: '#666',
								  font: { size: 12, family: 'Arial' },
								  boxWidth: 40
								}
							  },
							  datalabels: {
								align: function(context) {
								  var value = context.dataset.data[context.dataIndex];
								  return value < 0 ? 'bottom' : 'top';
								},
								offset: 4,
								color: function(context) {
								  var value = context.dataset.data[context.dataIndex];
								  return value < 0 ? 'red' : 'green';
								},
								font: {
								  weight: 'bold',
								  size: 11
								},
								formatter: function(value) {
								  return value.toLocaleString('pt-BR');
								}
							  },
							  tooltip: {
								callbacks: {
								  label: function(context) {
									return ' Exp: ' + context.parsed.y.toLocaleString('pt-BR');
								  }
								}
							  }
							},
							scales: {
							  y: {
								grid: { color: 'rgba(0, 0, 0, 0.05)' },
								ticks: { color: '#666' }
							  },
							  x: {
								grid: { color: 'rgba(0, 0, 0, 0.05)' },
								ticks: { color: '#666' }
							  }
							}
						  }
						});
					  });
					</script>
				</td>
			</tr>
		</table>
		<!-- EXP HISTORY_END -->
		{% endif %}

		{{ hook('HOOK_CHARACTERS_BEFORE_SIGNATURE') }}

		{% if setting('core.signature_enabled') %}
		<!-- SIGNATURE -->
		<script type="text/javascript">
			function showSignLinks()
			{
				if(document.getElementById('signLinks').style.display == "none")
				{
					document.getElementById('signLinks').style.display = "inline";
					document.getElementById('signText').innerHTML = "Hide links";
				}
				else
				{
					document.getElementById('signLinks').style.display = "none";
					document.getElementById('signText').innerHTML = "Show links";
				}
			}
		</script>
		<br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%"><tr bgcolor="{{ config.vdarkborder }}"><td colspan=2 class="white"><b>Signature</b></td></tr>
			<tr bgcolor="{{ config.lightborder }}"><td align="center" valign="top">
				<img src="{{ signature_url }}" alt="Signature for player {{ player.getName() }}">
				<br/>
				<b><a href="#" onclick="showSignLinks(); return false;" id="signText">Show links</a></b>
				<br/>
				<table id="signLinks" style="display: none;">
					<tr>
						<td>Website:</td>
						<td><input type="text" value="<a href=&quot;{{ player_link }}&quot;><img src=&quot;{{ signature_url }}&quot;></a>" style="width: 400px;" onclick="this.select()"></td>
					</tr>
					<tr>
						<td>Forum:</td>
						<td><input type="text" value="[URL={{ player_link }}][IMG]{{ signature_url }}[/IMG][/URL]" style="width: 400px;" onclick="this.select()"></td>
					</tr>
					<tr>
						<td>Direct link:</td>
						<td><input type="text" value="{{ signature_url }}" style="width: 400px;" onclick="this.select()"></td>
					</tr>
				</table>
			</td></tr>
		</table>
		<!-- SIGNATURE_END -->
		{% endif %}
		{{ hook('HOOK_CHARACTERS_AFTER_SIGNATURE') }}
		{% if not player.isHidden() %}
		{% set rows = 0 %}
		<!-- ACCOUNT_INFORMATION -->
		<br/><br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%">
			<tr bgcolor="{{ config.vdarkborder }}">
				<td colspan="2" class="white"><b>Account Information</b></td>
			</tr>

			{% set realName = account.getRLName() %}
			{% if realName is not empty %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td width="20%">Real name:</td>
				<td>{{ realName }}</td>
			</tr>
			{% endif %}

			{% set group = player.getGroup() %}
			{% if group.isLoaded() and group.getId() != 1 %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td>Position:</td>
				<td>{{ group.getName()|capitalize }}</td>
			</tr>
			{% endif %}

			{% set realLocation = account.getLocation() %}
			{% if realLocation is not empty %}
			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td width="20%">Location:</td>
				<td>{{ realLocation }}</td>
			</tr>
			{% endif %}

			{% set rows = rows + 1 %}
			<tr bgcolor="{{ getStyle(rows) }}">
				<td width="20%">Created:</td>
				<td>{{ account.getCreated()|date("j F Y, g:i a") }}
					{% if bannedUntil matches '/^\\d+$/' or bannedUntil == '-1' %}
						<span style="color: red">[Banished {% if bannedUntil == '-1' %}forever{% else %}until {{ bannedUntil|date('d F Y, h:s') }}{% endif %}]</span>
					{% else %}
					{{ bannedUntil|raw }}
					{% endif %}
				</td>
			</tr>
		</table>
		<!-- ACCOUNT_INFORMATION_END -->
		{{ hook('HOOK_CHARACTERS_AFTER_ACCOUNT') }}
		<!-- CHARACTERS_LIST -->
		<br/><br/>
		<table border="0" cellspacing="1" cellpadding="4" width="100%">
			<tr bgcolor="{{ config.vdarkborder }}">
				<td colspan=4 class="white"><b>Characters</b></td>
			</tr>
			<tr bgcolor="{{ config.darkborder }}">
				<td width="62%"><B>Name</b></td>
				<td width="30%"><B>Level</b></td>
				<td width="8%"><b>Status</b></td>
				<td><b>&#160;</b></td>
			</tr>
			{% set i = 0 %}
			{% for player in account_players %}
				{% if not player.isHidden() and (config('characters')['deleted'] or not player.isDeleted()) %}
				{% set i = i + 1 %}
			<tr bgcolor="{{ getStyle(i) }}">
				<td>
					<nobr>{{ i }}.&#160;{{ player.getName() }}{% if player.isDeleted() %}<span style="color: red"> [DELETED]</span>{% endif %}</nobr>
				</td>

				<td>{{ player.getLevel() }} {{ player.getVocationName() }}</td>
				<td>{% if player.isOnline() %}<b><span style="color: green">Online</span></b>{% endif %}</td>
				<td>
					<table border="0" cellspacing="0" cellpadding="0">
						<form action="{{ getLink('characters') }}" method="post">
							{{ csrf() }}
							<tr>
								<td>
									<input type="hidden" name="name" value="{{ player.getName() }}"/>
									{% set button_name = "View" %}
									{{ include('buttons.base.html.twig') }}
								</td>
							</tr>
						</form>
					</table>
				</td>
			</tr>
				{% endif %}
			{% endfor %}
		</table>
		<!-- CHARACTERS_LIST_END -->
		{% endif %}
		{{ hook('HOOK_CHARACTERS_AFTER_CHARACTERS') }}
		{% if canEdit %}
			<a href="{{ constant('ADMIN_URL') }}?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
				<img src="images/edit.png"/>Edit
			</a>
		{% endif %}
		</td>
		<td>
			<img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0">
		</td>
	</tr>
</table>
<br/><br/>{{ search_form|raw }}
