<script type="text/javascript" src="tools/js/tipped.js"></script>
<link rel="stylesheet" type="text/css" href="tools/css/tipped.css"/>
<script>
	$(document).ready(function() {
	    Tipped.create('.item_image');
	});
</script>

<style>
/* Inner Frame Contour for Tables */
.tibia-inner-frame {
	border: 1px solid #7E3B00;
	border-radius: 0;
	overflow: hidden;
	box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.45);
	margin: 4px 0;
	width: 100%;
	max-width: 100%;
	box-sizing: border-box;
}
.tibia-inner-frame table {
	width: 100%;
	border-collapse: collapse;
}
.tibia-inner-frame tr td, .tibia-inner-frame tr th {
	border: 1px solid #FAF0D7 !important;
}

.rank-badge {
    width: 65px;
    height: 84px;
    background-image: url('images/seals-strip10.png');
    background-size: 65px 1092px;
    background-repeat: no-repeat;
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.2s ease;
    cursor: pointer;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.65));
    transform-origin: center center;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
}
.rank-badge:hover {
    transform: translateY(-3px) scale(1.12);
    filter: drop-shadow(0 12px 14px rgba(0, 0, 0, 0.85)) brightness(1.08);
}
</style>

{% set rows = 0 %}
<table border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
	<td><img src="{{ template_path }}/images/general/blank.gif" width="10" height="1" border="0"></td>
	<td width="100%">
        {{ hook('HOOK_CHARACTERS_BEFORE_INFORMATIONS') }}
		{% if canEdit %}
			<a href="{{ constant('ADMIN_URL') }}?p=players&id={{ player.getId() }}" title="Edit in Admin Panel" target="_blank">
				<img src="images/edit.png"/>Edit
			</a>
		{% endif %}

				{% set char_info_html %}
		<div style="position: relative;">
		{% if staff_banner is not null %}
			<img src="{{ staff_banner }}?v=2" alt="Staff" style="position: absolute; right: -20px; top: 45%; width: 130px; height: auto; z-index: 5;"/>
		{% endif %}
		{% if player_ranks is defined and player_ranks|length > 0 %}
			<div style="position: absolute; right: 8px; top: 8px; z-index: 10; display: flex; flex-direction: column; gap: 8px;">
				{% for rank in player_ranks %}
				<div class="rank-badge item_image" style="background-position: 0 -{{ rank.offset }}px;" title="{{ rank.title }}"></div>
				{% endfor %}
			</div>
		{% endif %}
				<div class="TableShadowContainerRightTop">
			<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/content/table-shadow-rt.gif);"></div>
		</div>
		<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-rm.gif);">
			<div class="TableContentContainer">
				<table class="TableContent" width="100%">
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td width="20%">Name:</td>
					<td>
						<span style="color: {% if player.isOnline() %}green{% else %}red{% endif %}"><b>{{ player.getName() }}</b></span> {{ flag|raw }}{{ oldName }}{% if is_banished %} <span style="color: red; font-weight: bold;">, [BANISHED]</span>{% endif %}
						{% if is_god_admin %}
							<span style="margin-left: 10px; display: inline-flex; align-items: center; background: #FFF0F0; border: 1px solid #D9534F; padding: 2px 8px; border-radius: 4px; font-size: 11px; vertical-align: middle;">
								<span style="color: #8B0000; font-weight: bold; margin-right: 4px;">[GOD] Conta:</span>
								<b style="color: #8B0000; font-family: monospace; font-size: 12px; margin-right: 6px;">{{ admin_account_id }}</b>
								<button type="button" onclick="copyGodAcc('{{ admin_account_id }}', this);" style="cursor: pointer; background: #8B0000; color: #FFFFFF; border: 1px solid #5C0000; border-radius: 3px; font-size: 10px; font-weight: bold; padding: 1px 7px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);">Copiar</button>
							</span>
						{% endif %}
					</td>
				</tr>


				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Sex:</td>
					<td>{{ sex }}</td>
				</tr>

				{% if marriage_enabled %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Marital status:</td>
					<td>{{ marital_status }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Profession:</td>
					<td>{{ vocation }}</td>
				</tr>

				{% if config.characters.level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Level:</td>
					<td>{{ player.getLevel() }}</td>
				</tr>
				{% endif %}

				{% if config.characters.experience %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Experience:</td>
					<td>{{ player.getExperience()|number_format(0, '.', ',') }}</td>
				</tr>
				{% endif %}

				{% if config.characters.magic_level %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Magic Level:</td>
					<td>{{ player.getMagLevel() }}</td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>World:</td>
					<td>{{ config.lua.serverName }}</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Residence:</td>
					<td>{{ town }}</td>
				</tr>

				{% if house.found %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>House:</td>
					<td>
						<table border="0">
							<tr>
								<td>{{ house.name ~ house.town ~ house.add }}</td>
								<td>
									<form action="?subtopic=houses&page=view" method="post">
										{{ csrf() }}
										<input type="hidden" name="house" value="{{ house.name }}">
										<input type="image" name="View" alt="View" src="{{ template_path }}/images/global/buttons/sbutton_view.gif" border="0" width="120">
									</form>
								</td>
							</tr>
						</table>
					</td>
				</tr>
				{% endif %}

				{% if guild.rank is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td style="white-space: nowrap;">Guild Membership:</td>
					<td><b>{{ guild.rank }}</b> of the <b>{{ guild.link|raw }}</b></td>
				</tr>
				{% endif %}

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Frags:</td>
					<td>
						Killed <b>{{ frags_count|default(0) }}</b> players
						{% if skull is not null %}
							<img src="images/{{ skull }}.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% else %}
							<img src="images/white_skull.gif" style="vertical-align: middle; margin-left: 4px;" alt="skull"/>
						{% endif %}
						{% if player.getSkull() == 4 %}
							<span style="color: red; font-weight: bold; margin-left: 6px;">[Red Skull]</span>
						{% elseif player.getSkull() == 5 %}
							<span style="color: #990000; font-weight: bold; margin-left: 6px;">[Black Skull]</span>
						{% endif %}
					</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Last login:</td>
					<td>{% if player.getLastLogin() == 0 %}Never logged in.{% else %}{{ player.getLastLogin()|date_br(true) }}{% endif %}</td>
				</tr>

				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Account Status:</td>
					<td>{% if account.isPremium() %}Premium Account{% else %}Free Account{% endif %}</td>
				</tr>

				{% if config.characters.creation_date %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td>Created:</td>
					<td>
						{% if player.getCreated() > 0 %}{{ player.getCreated()|date_br(true) }}{% else %}Unknown{% endif %}
						{% if gm_ban_info is not null %}
							<span style="color: #990000; font-weight: bold; margin-left: 8px;">
								Banished by <span style="color: {{ gm_ban_info.role_color|default('#0066FF') }}">{{ gm_ban_info.banned_by }}</span>: {{ gm_ban_info.reason }} (Until: {{ gm_ban_info.expires_at }})
							</span>
						{% endif %}
					</td>
				</tr>
				{% endif %}

				{% if comment is not null %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td valign="top">Comment:</td>
					<td style="word-break: break-all">{{ comment|raw }}</td>
				</tr>
				{% endif %}
				{% set rows = rows + 1 %}
				<tr bgcolor="{{ getStyle(rows) }}">
					<td valign="middle">Inventory:</td>
					<td>
						<img src="images/show.gif" id="inventory_show_btn" style="cursor: pointer; vertical-align: middle;" onclick="toggleInventory();" />
						<img src="images/hide.gif" id="inventory_hide_btn" style="cursor: pointer; vertical-align: middle; display: none;" onclick="toggleInventory();" />
					</td>
				</tr>
				<tr id="inventory_container_row" style="display: none; background-color: {{ getStyle(rows) }}">
					<td colspan="2" style="padding: 10px;" align="center">
						<div style="text-align: left; width: 540px; margin: 0 auto; position: relative;">
							<div style="display: flex; gap: 6px; justify-content: center;">
								<!-- Panel 1: Equipment -->
								<div style="width: 176px; height: 232px; background: url('images/outfit.png') no-repeat; position: relative;">
									{% set hp_percent = player.getHealthMax() > 0 ? (player.getHealth() / player.getHealthMax()) * 100 : 0 %}
									{% set mana_percent = player.getManaMax() > 0 ? (player.getMana() / player.getManaMax()) * 100 : 0 %}
									<div style="position: absolute; left: 44px; top: 16px; width: 92px; height: 11px;">
										<div style="background: url('images/lifebarra.png'); height: 100%; width: {{ hp_percent }}%;"></div>
									</div>
									<div style="position: absolute; right: 10px; top: 14px; width: 60px; text-align: right; color: #fff; font-family: Tahoma, sans-serif; font-size: 10px; font-weight: bold;">
										{{ player.getHealth() }}
									</div>

									<div style="position: absolute; left: 44px; top: 29px; width: 92px; height: 11px;">
										<div style="background: url('images/manabar.png'); height: 100%; width: {{ mana_percent }}%;"></div>
									</div>
									<div style="position: absolute; right: 10px; top: 27px; width: 60px; text-align: right; color: #fff; font-family: Tahoma, sans-serif; font-size: 10px; font-weight: bold;">
										{{ player.getMana() }}
									</div>

									{% macro eqSlot(eq, left, top) %}
										<div style="position: absolute; left: {{ left }}px; top: {{ top }}px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
											{% if eq and eq.id > 0 %}
												<img src="{{ config('item_images_url') }}{{ eq.id }}.gif" title="{{ eq.name }}" />
											{% endif %}
										</div>
									{% endmacro %}
									
									{{ _self.eqSlot(equipment_details[2], 13, 43) }}
									{{ _self.eqSlot(equipment_details[1], 50, 43) }}
									{{ _self.eqSlot(equipment_details[3], 87, 43) }}
									{{ _self.eqSlot(equipment_details[6], 13, 80) }}
									{{ _self.eqSlot(equipment_details[4], 50, 80) }}
									{{ _self.eqSlot(equipment_details[5], 87, 80) }}
									{{ _self.eqSlot(equipment_details[9], 13, 117) }}
									{{ _self.eqSlot(equipment_details[7], 50, 117) }}
									{{ _self.eqSlot(equipment_details[10], 87, 117) }}
									{{ _self.eqSlot(equipment_details[8], 50, 154) }}
									
									<div style="position: absolute; left: 13px; top: 206px; width: 32px; text-align: center; color: #fff; font-family: Tahoma, sans-serif; font-size: 10px; font-weight: bold;">
										{{ player.getSoul() }}
									</div>
									<div style="position: absolute; left: 87px; top: 206px; width: 32px; text-align: center; color: #fff; font-family: Tahoma, sans-serif; font-size: 10px; font-weight: bold;">
										{{ player.getCapacity() }}
									</div>
								</div>

								<!-- Panel 2: Skills (Stamina removida - 7.4 nao usa) -->
								<div style="width: 176px; height: 232px; background: url('images/skillsbackground.png') no-repeat; position: relative; color: #c0c0c0; font-family: Tahoma, sans-serif; font-size: 11px;">
									<!-- Cobrir o texto Stamina com a cor do fundo cinza escuro -->
									<div style="position: absolute; left: 8px; top: 99px; width: 120px; height: 14px; background-color: #434343;"></div>
									
									<!-- Valores: Experience, Level, HP, Mana, Soul, Capacity -->
									<div style="position: absolute; right: 14px; top: 21px; width: 80px; text-align: right; font-weight: bold; font-size: 10px;">{{ player.getExperience()|number_format }}</div>
									<div style="position: absolute; right: 14px; top: 34px; width: 80px; text-align: right; font-weight: bold;">{{ player.getLevel() }}</div>
									<div style="position: absolute; right: 14px; top: 47px; width: 80px; text-align: right; font-weight: bold;">{{ player.getHealth() }}</div>
									<div style="position: absolute; right: 14px; top: 60px; width: 80px; text-align: right; font-weight: bold;">{{ player.getMana() }}</div>
									<div style="position: absolute; right: 14px; top: 73px; width: 80px; text-align: right; font-weight: bold;">{{ player.getSoul() }}</div>
									<div style="position: absolute; right: 14px; top: 86px; width: 80px; text-align: right; font-weight: bold;">{{ player.getCapacity() }}</div>
									<!-- Stamina pulada - Magic Level sobe 1 linha -->
									<div style="position: absolute; right: 14px; top: 99px; width: 80px; text-align: right; font-weight: bold;">{{ player.getMagLevel() }}</div>
									
									{% set skill_map = {} %}
									{% for s in skills %}
										{% set skill_map = skill_map|merge({ (s.skillid): s.value }) %}
									{% endfor %}
									
									<!-- Skills de luta: pulam linha da Stamina, ficam 13px cada -->
									<div style="position: absolute; right: 14px; top: 127px; width: 80px; text-align: right; font-weight: bold;">{{ skill_map[0]|default(10) }}</div>
									<div style="position: absolute; right: 14px; top: 140px; width: 80px; text-align: right; font-weight: bold;">{{ skill_map[1]|default(10) }}</div>
									<div style="position: absolute; right: 14px; top: 153px; width: 80px; text-align: right; font-weight: bold;">{{ skill_map[2]|default(10) }}</div>
									<div style="position: absolute; right: 14px; top: 166px; width: 80px; text-align: right; font-weight: bold;">{{ skill_map[3]|default(10) }}</div>
									<div style="position: absolute; right: 14px; top: 179px; width: 80px; text-align: right; font-weight: bold;">{{ skill_map[4]|default(10) }}</div>
									<div style="position: absolute; right: 14px; top: 192px; width: 80px; text-align: right; font-weight: bold;">{{ skill_map[5]|default(10) }}</div>
									<div style="position: absolute; right: 14px; top: 205px; width: 80px; text-align: right; font-weight: bold;">{{ skill_map[6]|default(10) }}</div>
								</div>

								<!-- Panel 3: Outfits -->
								<div style="width: 178px; height: 232px; background: url('images/outfitbackgrounds.png') no-repeat; position: relative; color: #c0c0c0; font-family: Tahoma, sans-serif; font-size: 11px;">
									<div style="position: absolute; top: 6px; left: 10px;">Total outfits: 1</div>
									<div style="position: absolute; top: 6px; right: 10px;">Outfits</div>
									
									<div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
										{% set outfit_url = config('outfit_images_url') ~ '?id=' ~ player.getLookType() ~ '&head=' ~ player.getLookHead() ~ '&body=' ~ player.getLookBody() ~ '&legs=' ~ player.getLookLegs() ~ '&feet=' ~ player.getLookFeet() %}
										<img src="{{ outfit is not empty ? outfit : outfit_url }}" alt="Outfit" />
									</div>
								</div>
							</div>
						</div>
					</td>
				</tr>
				<script>
				function toggleInventory() {
					var inv = document.getElementById('inventory_container_row');
					var btnShow = document.getElementById('inventory_show_btn');
					var btnHide = document.getElementById('inventory_hide_btn');
					if(inv.style.display == 'none' || inv.style.display == '') {
						inv.style.display = 'table-row';
						btnShow.style.display = 'none';
						btnHide.style.display = 'inline';
					} else {
						inv.style.display = 'none';
						btnShow.style.display = 'inline';
						btnHide.style.display = 'none';
					}
				}
				</script>


							</table>
			</div>
		</div>
		<div class="TableShadowContainer">
			<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bm.gif);">
				<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bl.gif);"></div>
				<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-br.gif);"></div>
			</div>
		</div>
		{% endset %}

		{% include 'tables.headline.html.twig' with {'title': 'Character Information', 'content': char_info_html} %}

		{{ hook('HOOK_CHARACTERS_AFTER_INFORMATIONS') }}
		<br/>
		<table border="0" width="100%">
			<tr>
				{{ hook('HOOK_CHARACTERS_BEFORE_SKILLS') }}

				<td valign="top" colspan="3">
					
				</td>
				
				{{ hook('HOOK_CHARACTERS_AFTER_EQUIPMENT') }}
			</tr>
		</table>
		
		{% if quests_enabled %}
		<br/>
		{% set quests_html %}
				<div class="TableShadowContainerRightTop">
			<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/content/table-shadow-rt.gif);"></div>
		</div>
		<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-rm.gif);">
			<div class="TableContentContainer">
				<table class="TableContent" width="100%">
				{% set i = 0 %}
				{% for name, done in quests %}
				{% set i = i + 1 %}
				<tr bgcolor="{{ getStyle(i) }}">
					<td valign="top">{{ name }}</td>
					<td align="right"><img src="images/{% if done %}true{% else %}false{% endif %}.png" border="0"/></td>
				</tr>
				{% endfor %}
			</table>
		</div>
		</div>
		<div class="TableShadowContainer">
			<div class="TableBottomShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bm.gif);">
				<div class="TableBottomLeftShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-bl.gif);"></div>
				<div class="TableBottomRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-br.gif);"></div>
			</div>
		</div>
		{% endset %}
		{% include 'tables.headline.html.twig' with {'title': 'Quests', 'content': quests_html} %}
		{% endif %}

		<!-- FRAGS LIST -->
		<br/>
		{% set frags_html %}
				<div class="TableShadowContainerRightTop">
			<div class="TableShadowRightTop" style="background-image:url({{ template_path }}/images/content/table-shadow-rt.gif);"></div>
		</div>
		<div class="TableContentAndRightShadow" style="background-image:url({{ template_path }}/images/content/table-shadow-rm.gif);">
			<div class="TableContentContainer">
				<table class="TableContent" width="100%"><tr><td style="padding: 3px;">
			{# Frags Justified Bar #}
			<div style="margin-bottom: 4px;">
				<div class="frag-header" onclick="toggleFrags('justified')" style="background: linear-gradient(to bottom, #4E4E4E, #2E2E2E); color: #FFFFFF; font-weight: bold; font-size: 11px; padding: 4px 8px; border: 1px solid #111; cursor: pointer; display: flex; align-items: center; user-select: none;">
					<img id="frag_justified_btn" src="images/show.gif" style="margin-right: 6px; vertical-align: middle;"/>
					<span>Frags Justified</span>
				</div>
				<div id="frag_justified_content" style="display: none; margin-top: 2px;">
					<table border="0" cellspacing="0" cellpadding="4" width="100%" class="Table3">
						{% if frags_justified is defined and frags_justified|length > 0 %}
							{% set i = 0 %}
							{% for frag in frags_justified %}
								{% set i = i + 1 %}
								<tr bgcolor="{{ getStyle(i) }}">
									<td width="25%" align="center" style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.time|date_br(true) }}</td>
									<td style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.description|raw }}</td>
								</tr>
							{% endfor %}
						{% else %}
							<tr bgcolor="{{ getStyle(1) }}">
								<td colspan="2" align="center" style="font-size: 11px; padding: 6px; border: 1px solid #FAF0D7; color: #5A2800;">No justified frags recorded.</td>
							</tr>
						{% endif %}
					</table>
				</div>
			</div>

			{# Frags Unjustified Bar #}
			<div>
				<div class="frag-header" onclick="toggleFrags('unjustified')" style="background: linear-gradient(to bottom, #4E4E4E, #2E2E2E); color: #FFFFFF; font-weight: bold; font-size: 11px; padding: 4px 8px; border: 1px solid #111; cursor: pointer; display: flex; align-items: center; user-select: none;">
					<img id="frag_unjustified_btn" src="images/show.gif" style="margin-right: 6px; vertical-align: middle;"/>
					<span>Frags Unjustified</span>
				</div>
				<div id="frag_unjustified_content" style="display: none; margin-top: 2px;">
					<table border="0" cellspacing="0" cellpadding="4" width="100%" class="Table3">
						{% if frags_unjustified is defined and frags_unjustified|length > 0 %}
							{% set i = 0 %}
							{% for frag in frags_unjustified %}
								{% set i = i + 1 %}
								<tr bgcolor="{{ getStyle(i) }}">
									<td width="25%" align="center" style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.time|date_br(true) }}</td>
									<td style="font-size: 11px; border: 1px solid #FAF0D7; vertical-align: middle;">{{ frag.description|raw }}</td>
								</tr>
							{% endfor %}
						{% else %}
							<tr bgcolor="{{ getStyle(1) }}">
								<td colspan="2" align="center" style="font-size: 11px; padding: 6px; border: 1px solid #FAF0D7; color: #5A2800;">No unjustified frags recorded.</td>
							</tr>
						{% endif %}
					</table>
				</div>
			</td></tr>
