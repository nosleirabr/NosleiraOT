		</div>
			<script type="text/javascript">
			  document.addEventListener("DOMContentLoaded", function() {
				var ctx = document.getElementById('exp_chart_canvas').getContext('2d');
				
				var labels = [
				  {% for exp in exp_history|reverse %}
				  '{{ exp.date }}',
				  {% endfor %}
				];
				
				var dataPoints = [
				  {% for exp in exp_history|reverse %}
				  {{ exp.exp_diff }},
				  {% endfor %}
				];

				Chart.register(ChartDataLabels);

				var chart = new Chart(ctx, {
				  type: 'line',
				  data: {
					labels: labels,
					datasets: [{
					  label: 'Player Experience Graphic History',
					  data: dataPoints,
					  fill: false,
					  pointBackgroundColor: function(context) {
						var value = context.dataset.data[context.dataIndex];
						return value < 0 ? 'red' : '#32CD32';
					  },
					  pointBorderColor: function(context) {
						var value = context.dataset.data[context.dataIndex];
						return value < 0 ? 'darkred' : 'darkgreen';
					  },
					  segment: {
						borderColor: function(context) {
						  return context.p1.parsed.y < 0 ? 'red' : '#32CD32';
						}
					  },
					  backgroundColor: '#32CD32',
					  borderColor: '#32CD32',
					  borderWidth: 1.5,
					  pointRadius: 4,
					  pointHoverRadius: 6
					}]
				  },
				  options: {
					responsive: false,
					maintainAspectRatio: false,
					layout: {
					  padding: { top: 30, bottom: 10, left: 10, right: 10 }
					},
					plugins: {
					  legend: { position: 'top', labels: { color: '#666', font: { size: 12, family: 'Arial' }, boxWidth: 40 } },
					  datalabels: {
						align: function(context) { return context.dataset.data[context.dataIndex] < 0 ? 'bottom' : 'top'; },
						offset: 4,
						color: function(context) { return context.dataset.data[context.dataIndex] < 0 ? 'red' : 'green'; },
						font: { weight: 'bold', size: 11 },
						formatter: function(value) { return value.toLocaleString('pt-BR'); }
					  },
					  tooltip: {
						callbacks: {
						  label: function(context) { return ' Exp: ' + context.parsed.y.toLocaleString('pt-BR'); }
						}
					  }
					},
					scales: {
					  y: { grid: { color: 'rgba(0, 0, 0, 0.05)' }, ticks: { color: '#666' } },
					  x: { grid: { color: 'rgba(0, 0, 0, 0.05)' }, ticks: { color: '#666' } }
					}
				  }
				});
			  });
			</script>
		</div>
