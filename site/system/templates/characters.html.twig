		<script type="text/javascript">
		  document.addEventListener("DOMContentLoaded", function() {
			var ctx = document.getElementById('exp_chart_canvas').getContext('2d');
			
			var labels = [
			  {% for exp in exp_history|reverse %}
			  {% if exp.date != 'Today' %}
			  '{{ exp.date }}',
			  {% endif %}
			  {% endfor %}
			];
			
			var dataPoints = [
			  {% for exp in exp_history|reverse %}
			  {% if exp.date != 'Today' %}
			  {{ exp.exp_diff }},
			  {% endif %}
			  {% endfor %}
			];

			Chart.register(ChartDataLabels);

			var chart = new Chart(ctx, {
			  type: 'line',
			  data: {
				labels: labels,
				datasets: [{
				  label: 'Player Experience Graphic History',
				  data: dataPoints,
				  fill: false,
				  tension: 0,
				  pointBackgroundColor: function(context) {
					var value = context.dataset.data[context.dataIndex];
					return value < 0 ? '#E60000' : '#00B000';
				  },
				  pointBorderColor: function(context) {
					var value = context.dataset.data[context.dataIndex];
					return value < 0 ? '#CC0000' : '#009000';
				  },
				  segment: {
					borderColor: function(context) {
					  return context.p1.parsed.y < 0 ? '#E60000' : '#32CD32';
					}
				  },
				  backgroundColor: '#32CD32',
				  borderColor: '#32CD32',
				  borderWidth: 1.5,
				  pointRadius: 4,
				  pointHoverRadius: 6
				}]
			  },
			  options: {
				responsive: true,
				maintainAspectRatio: false,
				layout: {
				  padding: { top: 10, bottom: 5, left: 10, right: 15 }
				},
				plugins: {
				  legend: {
					display: true,
					position: 'top',
					align: 'center',
					labels: {
					  color: '#4A3525',
					  font: { size: 12, family: 'Verdana, Arial, sans-serif' },
					  boxWidth: 40,
					  boxHeight: 12
					}
				  },
				  datalabels: {
					align: function(context) {
					  var index = context.dataIndex;
					  var count = context.dataset.data.length;
					  if (index === 0) return 'right';
					  if (index === count - 1) return 'left';
					  var prev = context.dataset.data[index - 1];
					  var curr = context.dataset.data[index];
					  var next = context.dataset.data[index + 1];
					  if (curr > prev && curr > next) return 'top';
					  if (curr < prev && curr < next) return 'top';
					  return 'left';
					},
					offset: 6,
					color: function(context) { return context.dataset.data[context.dataIndex] < 0 ? '#CC0000' : '#008000'; },
					font: { weight: 'bold', size: 11, family: 'Verdana, Arial, sans-serif' },
					formatter: function(value) {
					  if (value > 0) return '+' + value.toLocaleString('pt-BR');
					  if (value < 0) return value.toLocaleString('pt-BR');
					  return '0';
					}
				  },
				  tooltip: {
					callbacks: {
					  label: function(context) { return ' Exp: ' + (context.parsed.y > 0 ? '+' : '') + context.parsed.y.toLocaleString('pt-BR'); }
					}
				  }
				},
				scales: {
				  y: {
					grid: { color: 'rgba(0, 0, 0, 0.08)' },
					ticks: {
					  color: '#777777',
					  font: { size: 11, family: 'Verdana, Arial, sans-serif' },
					  callback: function(value) {
						return value.toLocaleString('pt-BR');
					  }
					}
				  },
				  x: {
					grid: { color: 'rgba(0, 0, 0, 0.08)' },
					ticks: {
					  color: '#4A3525',
					  maxRotation: 0,
					  minRotation: 0,
					  autoSkip: false,
					  font: { size: 11, family: 'Verdana, Arial, sans-serif' }
					}
				  }
				}
			  }
			});
		  });
		</script>
