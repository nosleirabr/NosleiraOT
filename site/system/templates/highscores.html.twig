<table border="0" cellpadding="0" cellspacing="0" width="100%">
	<tr>
		<td style="width: 17px"></td>
		<td>
			<div style="text-align:center"><h2>Ranking for {{ skillName }}{% if vocation is not null %} ({{ vocation }}){% endif %} on {{ config.lua.serverName }}</h2></div><br/>

			<table border="0" cellpadding="4" cellspacing="1" width="100%">
				<tr bgcolor="{{ config.vdarkborder }}">
					<td style="width: 10%" class="white"><b>Rank</b></td>

					{% if setting('core.highscores_outfit') %}
					<td class="white"><b>Outfit</b></td>
					{% endif %}

					<td width="45%" class="white"><b>Nome</b></td>

					{% if setting('core.highscores_vocation') %}
					<td width="20%" class="white" align="center"><b>Vocation</b></td>
					{% endif %}

					<td width="10%" class="white" align="center"><b>{{ levelName }}</b></td>

					{% if skill == constant('POT::SKILL__LEVEL') %}
					<td width="15%" class="white" align="center"><b>Points</b></td>
					{% endif %}
				</tr>

				{% if highscores|length < 1 %}
				<tr bgcolor="{{ config('darkborder') }}"><td colspan="100%">No records yet.</td></tr>
				{% else %}
					{% set row = 0 %}
					{% for player in highscores %}
					<tr bgcolor="{{ getStyle(row) }}">
						{% set row = row + 1 %}

						<td>{{ player.rank }}.</td>

						{% if setting('core.highscores_outfit') %}
						<td>{{ player.outfit|raw }}</td>
						{% endif %}

						<td>
							{% if setting('core.account_country') %}
								{{ player.flag|raw }}
							{% endif %}
							<a href="{{ player.link }}">
								<span {% if setting('core.highscores_online_status') %}style="color: {% if player.online > 0 %}green{% else %}red{% endif %}"{% endif %}><b>{{ player.name }}</b></span>
							</a>
						</td>

						{% if setting('core.highscores_vocation') %}
						<td align="center">
							{{ player.vocation }}
						</td>
						{% endif %}

						<td align="center">
							{{ player.value }}
						</td>

						{% if skill == constant('POT::SKILL__LEVEL') %}
							<td align="center">{{ player.experience }}</td>
						{% endif %}
					</tr>
					{% endfor %}
				{% endif %}
			</table>
			<table border="0" cellpadding="4" cellspacing="1" width="100%">
				{% if linkPreviousPage|length > 0 %}
					<tr><td style="width: 100%" align="right" valign="bottom"><a href="{{ linkPreviousPage }}" class="size_xxs">Previous Page</a></td></tr>
				{% endif %}

				{% if linkNextPage|length > 0 %}
					<tr><td style="width: 100%" align="right" valign="bottom"><a href="{{ linkNextPage }}" class="size_xxs">Next Page</a></td></tr>
				{% endif %}
			</table>
		</td>
		{% if setting('core.highscores_skills_box') or setting('core.highscores_vocation_box') %}
		<td width="5%"></td>
		<td width="15%" valign="top" align="right">
			{% if setting('core.highscores_skills_box') %}
			<table style="border: 0; width: 100%" cellpadding="4" cellspacing="1">
				<tr bgcolor="{{ config.vdarkborder }}">
					<td class="white" align="center"><B>Custom</B></TD>
				</tr>
				<tr bgcolor="{{ config.lightborder }}">
					<td align="center" style="padding: 5px;">
						<div style="margin-bottom: 2px;">
							<a href="{{ getLink('exphist') }}" title="Powergamers">
								<span class="size_xs" style="display:inline-block; width: 32px; height: 32px; line-height: 32px; border: 1px solid #000; background:#d4c0a1; font-weight: bold; color: black; text-decoration: none; font-size: 8px;">PG</span>
							</a>
						</div>
					</td>
				</tr>
			</table>
			<br/>
			<table style="border: 0; width: 100%" cellpadding="4" cellspacing="1">
				<tr bgcolor="{{ config.vdarkborder }}">
					<td class="white" align="center"><B>Category</B></TD>
				</tr>
				<tr bgcolor="{{ config.lightborder }}">
					<td align="center" style="padding: 5px;">
						{% for link, name in types %}
							<div style="margin-bottom: 2px;">
								<a href="{{ getLink('highscores') }}/{{ link|urlencode }}{% if vocation is not null %}/{{ vocation|urlencode }}{% endif %}" title="{{ name }}" style="text-decoration: none;">
									<img src="{{ config.url }}images/skills/{{ link }}.png" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" style="max-width: 32px; max-height: 32px; border: 1px solid #000; background:#d4c0a1;"/>
									<span class="size_xs" style="display:none; padding:4px; border:1px solid #000; background:#d4c0a1; color:black; font-weight:bold;">{{ name }}</span>
								</a>
							</div>
						{% endfor %}
					</td>
				</tr>
			</table>
			<br/>
			{% endif %}
			{% if setting('core.highscores_vocation_box') %}
			<table border="0" width="100%" cellpadding="4" cellspacing="1">
				<tr bgcolor="{{ config.vdarkborder }}">
					<td class="white" align="center"><b>Vocation Filter</b></td>
				</tr>
				<tr bgcolor="{{ config.lightborder }}">
					<td align="center" style="padding: 5px;">
						<div style="margin-bottom: 2px;">
							<a href="{{ getLink('highscores') }}/{{ list|urlencode }}" title="All Vocations" style="text-decoration: none;">
								<span class="size_xs" style="display:inline-block; width: 32px; height: 32px; line-height: 32px; border: 1px solid #000; background:#d4c0a1; font-weight: bold; color: black; text-align:center;">ALL</span>
							</a>
						</div>
						{% for i in 1..config.vocations_amount %}
							{% set voc_name_lower = config.vocations[i]|lower %}
							{% set voc_image = voc_name_lower %}
							{% if 'sorc' in voc_name_lower %}{% set voc_image = 'sorcerer' %}{% endif %}
							{% if 'drui' in voc_name_lower %}{% set voc_image = 'druid' %}{% endif %}
							{% if 'pala' in voc_name_lower %}{% set voc_image = 'paladin' %}{% endif %}
							{% if 'knig' in voc_name_lower %}{% set voc_image = 'knight' %}{% endif %}
							
							<div style="margin-bottom: 2px;">
								<a href="{{ getLink('highscores') }}/{{ list|urlencode }}/{{ config.vocations[i]|lower|urlencode }}" title="{{ config.vocations[i]}}" style="text-decoration: none;">
									<img src="{{ config.url }}images/{{ voc_image }}.png" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" style="max-width: 32px; max-height: 32px; border: 1px solid #000; background:#d4c0a1;"/>
									<span class="size_xs" style="display:none; padding:4px; border:1px solid #000; background:#d4c0a1; color:black; font-weight:bold;">{{ config.vocations[i] }}</span>
								</a>
							</div>
						{% endfor %}
					</td>
				</tr>
			</table>
			{% endif %}
		</td>
		<td style="width: 18px"></td>
		{% endif %}
	</tr>
</table>
